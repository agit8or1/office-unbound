[Unit]
Description=Office Unbound user portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ou-portal
Group=ou-portal
WorkingDirectory=/opt/ou-portal
EnvironmentFile=/etc/ou-portal/portal.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:create_app --factory --host 0.0.0.0 --port 443 \
  --ssl-keyfile /etc/ou-portal/tls/portal.key --ssl-certfile /etc/ou-portal/tls/portal.crt \
  --no-server-header --no-access-log --workers 1
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target

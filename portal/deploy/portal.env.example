# /etc/ou-portal/portal.env (root:ou-portal 0640). Lab values shown. No secret in this file: the client secret is read from a file.
PORTAL_BASE_URL=https://portal.ou-lab.internal
PORTAL_OIDC_ISSUER=https://auth.ou-lab.internal/realms/ou-lab
PORTAL_OIDC_CLIENT_ID=ou-portal
PORTAL_OIDC_CLIENT_SECRET_FILE=/etc/ou-portal/client-secret
PORTAL_FILES_URL=https://cloud.ou-lab.internal
# Lab: the mailbox server is gw1.ou-lab.internal (grommunio-web under /web, its own lab CA); production: one mail host per customer.
PORTAL_MAIL_WEB_URL=https://gw1.ou-lab.internal/web/
PORTAL_MAIL_HOST=gw1.ou-lab.internal
PORTAL_MAIL_DOMAIN=ou-lab.internal
PORTAL_IMAP_PORT=993
PORTAL_SMTP_PORT=587
PORTAL_DAV_BASE=/dav
PORTAL_ORG_NAME=Office Unbound (lab)
# Admin area for the customer's own administrators (Keycloak realm role org-admin). Leave PORTAL_ICS_URL unset and the area does not exist.
# The key is the per-customer service credential issued by the MSP (POST /api/v1/customers/<id>/tenant-admin on the ICS, shown once).
# PORTAL_ICS_URL=https://ics.example:8120
# PORTAL_ICS_KEY_FILE=/etc/ou-portal/ics-tenant-key
# PORTAL_ICS_CA_BUNDLE=/etc/ou-portal/ics-ca.pem
# PORTAL_ADMIN_ROLE=org-admin

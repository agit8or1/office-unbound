# PostgreSQL: 16 from Ubuntu 24.04 (noble) main archive (package postgresql-16).
PG_MAJOR="16"
# JDK for Keycloak: OpenJDK 21 from Ubuntu 24.04 archive (package openjdk-21-jre-headless).


# Lab topology. NON-SECRET. Sourced by install scripts and (optionally) tests.
# Lab-only domain: resolved via /etc/hosts on every lab VM and on the operator
# workstation. Not in public DNS. Change the 10.99.0.0/24 addresses to match
# the lab network you create.
LAB_DOMAIN="ou-lab.internal"
REALM="ou-lab"

HOST_KC="auth.${LAB_DOMAIN}"          # Keycloak
HOST_LDAP="ldap.${LAB_DOMAIN}"        # OpenLDAP (same machine as kc)
HOST_FILES="cloud.${LAB_DOMAIN}"      # OpenCloud + WOPI
HOST_OFFICE="office.${LAB_DOMAIN}"    # Collabora CODE
HOST_MAIL="mail.${LAB_DOMAIN}"        # grommunio
HOST_AUTODISCOVER="autodiscover.${LAB_DOMAIN}"
HOST_PORTAL="portal.${LAB_DOMAIN}"      # Office Unbound user portal (portal/)
HOST_CHAT="chat.${LAB_DOMAIN}"          # Element Web (spike-collab, ou-chat1)
HOST_MATRIX="matrix.${LAB_DOMAIN}"      # Synapse client/federation API (ou-chat1)
HOST_MAS="mas.${LAB_DOMAIN}"            # matrix-authentication-service (ou-chat1)
HOST_MEET="meet.${LAB_DOMAIN}"          # Jitsi Meet (spike-collab, ou-meet1)
HOST_MEETAUTH="meet-auth.${LAB_DOMAIN}" # Office Unbound Jitsi token service (ou-meet1)

IP_KC="192.168.186.241"      # nspawn ou-id1 (static)
IP_FILES="192.168.186.242"   # nspawn ou-files1 (static)
IP_OFFICE="192.168.186.243"  # nspawn ou-office1 (static)
IP_MAIL="10.99.0.14"
IP_PORTAL="192.168.186.244"  # nspawn ou-portal1 (static)
IP_CHAT="192.168.186.245"    # nspawn ou-chat1 (static)
IP_MEET="192.168.186.246"    # nspawn ou-meet1 (static)

# Isolated test mail domain (no public MX exists for it, ever).
MAIL_DOMAIN="${LAB_DOMAIN}"

LDAP_BASE_DN="dc=ou-lab,dc=internal"
LDAP_PEOPLE_DN="ou=people,${LDAP_BASE_DN}"
LDAP_GROUPS_DN="ou=groups,${LDAP_BASE_DN}"
LDAP_BIND_USER="svc-bind"             # cn=svc-bind,ou=system,<base> (read-only bind)

# Lab CA
CA_DIR="/root/ou-lab-ca"
TLS_DIR="/etc/ou-lab/tls"
SECRETS_DIR="/root/ou-lab-secrets"    # root-only, generated at runtime
BUNDLE_PATH="/root/ou-lab-bundle.tar.gz"

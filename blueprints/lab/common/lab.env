# Lab topology. NON-SECRET. Sourced by install scripts and (optionally) tests.
# Lab-only domain: resolved via /etc/hosts on every lab VM and on the operator
# workstation. Not in public DNS. Change the 10.99.0.0/24 addresses to match
# the lab network you create.
LAB_DOMAIN="ou-lab.internal"
REALM="ou-lab"

HOST_KC="auth.${LAB_DOMAIN}"          # Keycloak
HOST_LDAP="ldap.${LAB_DOMAIN}"        # lldap (same VM as kc)
HOST_FILES="cloud.${LAB_DOMAIN}"      # OpenCloud + WOPI
HOST_OFFICE="office.${LAB_DOMAIN}"    # Collabora CODE
HOST_MAIL="mail.${LAB_DOMAIN}"        # grommunio
HOST_AUTODISCOVER="autodiscover.${LAB_DOMAIN}"

IP_KC="10.99.0.11"
IP_FILES="10.99.0.12"
IP_OFFICE="10.99.0.13"
IP_MAIL="10.99.0.14"

# Isolated test mail domain (no public MX exists for it, ever).
MAIL_DOMAIN="${LAB_DOMAIN}"

LDAP_BASE_DN="dc=ou-lab,dc=internal"
LDAP_PEOPLE_DN="ou=people,${LDAP_BASE_DN}"
LDAP_GROUPS_DN="ou=groups,${LDAP_BASE_DN}"
LDAP_BIND_USER="svc-bind"             # member of lldap_strict_readonly

# Lab CA
CA_DIR="/root/ou-lab-ca"
TLS_DIR="/etc/ou-lab/tls"
SECRETS_DIR="/root/ou-lab-secrets"    # root-only, generated at runtime
BUNDLE_PATH="/root/ou-lab-bundle.tar.gz"

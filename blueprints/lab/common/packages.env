# Runtime package sets per role — single source for install AND restore scripts (restore drill finding 2026-11-15:
# a restore that re-derived packages missed inotify-tools and OpenCloud's posix driver panicked).
FILES_PKGS="nginx-light curl ca-certificates openssl jq ldap-utils inotify-tools"   # inotify-tools: posix driver needs inotifywait
ID_PKGS="slapd ldap-utils postgresql-16 openjdk-21-jre-headless curl ca-certificates openssl jq gettext-base"   # OpenLDAP + Keycloak node (Ubuntu 24.04)

# Groupware node (Debian 12 bookworm): Gromox from pinned source + sync/dav/web. Single source for build-from-source.sh (stage deps),
# gw-restore.sh. Found by the clean-room rebuild (2026-11-15): composer and the PHP/runtime packages were only ever installed by hand on ou-gw1.
GW_BUILD_PKGS="ca-certificates git build-essential autoconf automake libtool pkg-config cmake make m4 perl libfmt-dev libjsoncpp-dev libxml2-dev libzstd-dev libmariadb-dev libldap-dev libssl-dev libsqlite3-dev libtinyxml2-dev zlib1g-dev php-dev php-cli libcurl4-openssl-dev libpam0g-dev libxxhash-dev libc-ares-dev libkrb5-dev libgsasl-dev libgnutls28-dev libidn2-dev curl unzip xz-utils sqlite3 zstd gettext composer"
# php-gd: found by the webmail SSO test (2026-11-15): grommunio-web logs "Call to undefined function imagecreatefromstring()" in profilepicture and the hierarchy never loads
GW_RUN_PKGS="mariadb-server nginx php-fpm php-curl php-gd php-mbstring php-mysql php-sqlite3 php-xml php-zip php-redis php-soap php-intl postfix postfix-mysql redis-server ldap-utils python3-ldap3 python3-pymysql python3-requests openssl"
GW_PKGS="$GW_BUILD_PKGS $GW_RUN_PKGS"

#export OU_DIR_CMD='sudo systemd-run -M ou-id1 --quiet --pipe --wait /root/lab/spike-identity-files/kc/ldap-user.sh {action} {user} {extra}'
#export OU_DIR_PW_CMD='sudo systemd-run -M ou-id1 --quiet --pipe --wait /bin/grep ^OU_PASSWORD_{USER}= /root/ou-lab-secrets/test-users.env'
#export OU_KC_ADMIN_PASSWORD="$(sudo systemd-run -M ou-id1 --quiet --pipe --wait /bin/cat /root/ou-lab-secrets/keycloak-admin-password)"

# NON-SECRET configuration for the acceptance tests. Copy to lab-test.env
# (git-ignored by convention) and `source` it. NEVER put passwords here.
export OU_LAB_DOMAIN=ou-lab.internal
export OU_CA_FILE="$HOME/ou-lab-ca.crt"        # public CA cert copied from kc:/root/ou-lab-ca/ca.crt
# optional: ssh targets (key auth, passwordless sudo) enabling restart-persistence steps
#export OU_SSH_FILES=labadmin@cloud.ou-lab.internal
#export OU_SSH_OFFICE=labadmin@office.ou-lab.internal
#export OU_SSH_MAIL=labadmin@mail.ou-lab.internal
# Passwords come from the kc VM at runtime, straight into this shell (not to disk):
#   set -a; eval "$(ssh labadmin@auth.ou-lab.internal sudo cat /root/ou-lab-secrets/test-users.env)"; set +a
# which exports OU_PASSWORD_ALICE, _BOB, _CAROL, _DAVE, _ERIN.
# Sign-off runs: export OU_STRICT_SKIP=1   (any SKIP then fails the run)

# Derived from opencloud-compose@d4695d2 config/opencloud/csp.yaml with the lab
# hostnames substituted by install-files.sh (__IDP_HOST__, __OFFICE_HOST__).
# Trimmed: no companion / euro-office / OSM tiles / update server (lab has no
# internet egress requirement).
directives:
  child-src:
    - "'self'"
  connect-src:
    - "'self'"
    - 'blob:'
    - 'https://__IDP_HOST__/'
  default-src:
    - "'none'"
  font-src:
    - "'self'"
  frame-ancestors:
    - "'self'"
  frame-src:
    - "'self'"
    - 'blob:'
    - 'https://__OFFICE_HOST__/'
    - 'https://__IDP_HOST__/'
  img-src:
    - "'self'"
    - 'data:'
    - 'blob:'
    - 'https://__OFFICE_HOST__/'
  manifest-src:
    - "'self'"
  media-src:
    - "'self'"
    - 'blob:'
  object-src:
    - "'self'"
    - 'blob:'
  script-src:
    - "'self'"
    - "'unsafe-inline'"
    - 'https://__IDP_HOST__/'
  style-src:
    - "'self'"
    - "'unsafe-inline'"
    - 'blob:'
  worker-src:
    - "'self'"
    - 'blob:'

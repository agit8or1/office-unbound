# OpenCloud 9.1.0 environment for the lab. NO SECRETS in this file: the JWT
# secret, transfer secret etc. are generated by `opencloud init` into
# /etc/opencloud/opencloud.yaml (root:opencloud 0640).
# Variable semantics copied from opencloud-compose@d4695d2:
#   docker-compose.yml, idm/external-idp.yml, weboffice/collabora.yml
# Every name below is UNVERIFIED against 9.1.0 until the first real run:
# check `journalctl -u opencloud` for "unknown/ignored" warnings.
OC_CONFIG_DIR=/etc/opencloud
OC_BASE_DATA_PATH=/var/lib/opencloud
OC_URL=https://__FILES_HOST__
OC_LOG_LEVEL=info
OC_INSECURE=false
# TLS terminates at nginx on this VM
PROXY_TLS=false
PROXY_HTTP_ADDR=127.0.0.1:9200
PROXY_ENABLE_BASIC_AUTH=false
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml

# ---- external Keycloak (no embedded IdP); internal idm LDAP kept as shadow store
OC_EXCLUDE_RUN_SERVICES=idp
OC_OIDC_ISSUER=https://__IDP_HOST__/realms/__REALM__
PROXY_OIDC_REWRITE_WELLKNOWN=true
IDP_DOMAIN=__IDP_HOST__
WEBFINGER_WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email
WEBFINGER_DESKTOP_OIDC_CLIENT_ID=OpenCloudDesktop
WEBFINGER_DESKTOP_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_ANDROID_OIDC_CLIENT_ID=OpenCloudAndroid
WEBFINGER_ANDROID_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_IOS_OIDC_CLIENT_ID=OpenCloudIOS
WEBFINGER_IOS_OIDC_CLIENT_SCOPES=openid profile email offline_access

# ---- roles from the Keycloak "roles" claim
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
SETTINGS_SETUP_DEFAULT_ASSIGNMENTS=false

# ---- auto-provisioning into the internal idm LDAP on first OIDC login
# preferred_username is used for readable lab accounts. The compose reference
# uses `sub`; test that variant too (PROXY_USER_OIDC_CLAIM=sub, PROXY_AUTOPROVISION_CLAIM_USERNAME=sub).
PROXY_AUTOPROVISION_ACCOUNTS=true
PROXY_USER_OIDC_CLAIM=preferred_username
PROXY_USER_CS3_CLAIM=username
PROXY_AUTOPROVISION_CLAIM_USERNAME=preferred_username
GRAPH_USERNAME_MATCH=none
OC_ADMIN_USER_ID=

# ---- storage: posix driver, watch fs (eval doc section 1)
STORAGE_USERS_DRIVER=posix
STORAGE_USERS_POSIX_WATCH_FS=true

# ---- collaboration (WOPI) service runs inside the main process
OC_ADD_RUN_SERVICES=collaboration
FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR=eu.opencloud.api.collaboration
COLLABORATION_APP_NAME=CollaboraOnline
COLLABORATION_APP_PRODUCT=Collabora
COLLABORATION_APP_ADDR=https://__OFFICE_HOST__
COLLABORATION_APP_ICON=https://__OFFICE_HOST__/favicon.ico
COLLABORATION_WOPI_SRC=https://__FILES_HOST__
COLLABORATION_APP_INSECURE=false
COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false
GRAPH_AVAILABLE_ROLES=b1e2218d-eef8-4d4c-b82d-0f1a1b48f3b5,a8d5fe5e-96e3-418d-825b-534dbdf22b99,fb6c3e19-e378-47e5-b277-9732f9de6e21,58c63c02-1d89-4572-916a-870abc5a1b7d,2d00ce52-1fc2-4dbc-8b95-a73b73395f5a,1c996275-f1c9-4e71-abdf-a42f6495e960,312c0871-5ef7-4b3a-85b6-0e4074c64049,aa97fe03-7980-45ac-9e50-b325749fd7e6


# OpenCloud 9.1.0 environment for the lab. NO SECRETS in this file: JWT/transfer secrets live in
# /etc/opencloud/opencloud.yaml (generated by `opencloud init`); the LDAP bind password is appended
# at install time from the root-only secrets dir. Executed in nspawn ou-files1; names verified by a real run
# (see docs/status/identity-files-lab-results.md for what changed vs. the first draft).
OC_CONFIG_DIR=/etc/opencloud
OC_BASE_DATA_PATH=/var/lib/opencloud
OC_URL=https://__FILES_HOST__
OC_LOG_LEVEL=info
OC_INSECURE=false
# TLS terminates at nginx on this machine; opencloud proxy listens on loopback plain HTTP
PROXY_TLS=false
PROXY_HTTP_ADDR=127.0.0.1:9200
PROXY_ENABLE_BASIC_AUTH=false
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml

# ---- external Keycloak, NO embedded IdP and NO embedded idm: the shared OpenLDAP is the (read-only) user backend
# (pattern of opencloud-compose idm/ldap-keycloak.yml). One user store: no autoprovisioning, no shadow copy.
OC_EXCLUDE_RUN_SERVICES=idm,idp
OC_OIDC_ISSUER=https://__IDP_HOST__/realms/__REALM__
PROXY_OIDC_REWRITE_WELLKNOWN=true
IDP_DOMAIN=__IDP_HOST__
WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email
WEBFINGER_DESKTOP_OIDC_CLIENT_ID=OpenCloudDesktop
WEBFINGER_DESKTOP_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_ANDROID_OIDC_CLIENT_ID=OpenCloudAndroid
WEBFINGER_ANDROID_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_IOS_OIDC_CLIENT_ID=OpenCloudIOS
WEBFINGER_IOS_OIDC_CLIENT_SCOPES=openid profile email offline_access

# ---- roles from the Keycloak "roles" claim
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
SETTINGS_SETUP_DEFAULT_ASSIGNMENTS=false
OC_ADMIN_USER_ID=

# ---- users: matched by the LDAP entryUUID exposed by Keycloak as claim "uuid"
PROXY_AUTOPROVISION_ACCOUNTS=false
PROXY_USER_OIDC_CLAIM=uuid
PROXY_USER_CS3_CLAIM=userid
GRAPH_USERNAME_MATCH=none

# ---- shared OpenLDAP, read only (bind user has no write ACL)
OC_LDAP_URI=ldaps://__LDAP_HOST__:636
OC_LDAP_INSECURE=false
OC_LDAP_CACERT=/etc/ou-lab/tls/ca.crt
OC_LDAP_BIND_DN=cn=svc-bind,ou=system,__BASE_DN__
OC_LDAP_USER_BASE_DN=ou=people,__BASE_DN__
OC_LDAP_USER_FILTER=(!(pwdAccountLockedTime=*))
OC_LDAP_USER_OBJECTCLASS=inetOrgPerson
OC_LDAP_USER_SCHEMA_ID=entryUUID
OC_LDAP_USER_SCHEMA_ID_IS_OCTETSTRING=false
OC_LDAP_GROUP_BASE_DN=ou=groups,__BASE_DN__
OC_LDAP_GROUP_OBJECTCLASS=groupOfNames
OC_LDAP_GROUP_SCHEMA_ID=entryUUID
OC_LDAP_DISABLE_USER_MECHANISM=none
OC_LDAP_SERVER_WRITE_ENABLED=false
GRAPH_LDAP_SERVER_UUID=true
GRAPH_LDAP_REFINT_ENABLED=true
FRONTEND_READONLY_USER_ATTRIBUTES=user.onPremisesSamAccountName,user.displayName,user.mail,user.passwordProfile,user.accountEnabled,user.appRoleAssignments

# ---- storage: posix driver
STORAGE_USERS_DRIVER=posix
STORAGE_USERS_POSIX_WATCH_FS=true

# ---- collaboration (WOPI) service: started as a separate unit (opencloud-collaboration.service)
COLLABORATION_APP_NAME=CollaboraOnline
COLLABORATION_APP_PRODUCT=Collabora
COLLABORATION_APP_ADDR=https://__OFFICE_HOST__
COLLABORATION_APP_ICON=https://__OFFICE_HOST__/favicon.ico
COLLABORATION_WOPI_SRC=https://__FILES_HOST__
COLLABORATION_APP_INSECURE=false
COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false

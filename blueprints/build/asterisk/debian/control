Build-Depends: debhelper-compat (= 13), build-essential, pkg-config, bzip2, patch, curl, ca-certificates, python3, libssl-dev,
 libjansson-dev, libxml2-dev, libsqlite3-dev, uuid-dev, libedit-dev, libsrtp2-dev, libxslt1-dev, libncurses-dev, libcap-dev, libgsm1-dev, zlib1g-dev

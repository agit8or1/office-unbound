# Ubuntu 24.04 (noble) golden image profile. Built from the SIGNED ARCHIVE with mmdebstrap exactly like Debian (no loop mount, no libguestfs).
# PINNED TRUST ANCHOR: the PRIMARY key that signs the noble Release files (InRelease / Release.gpg):
#   F6EC B376 2474 EDA9 D21B 7022 8719 20D1 991B C93C   Ubuntu Archive Automatic Signing Key (2018) <ftpmaster@ubuntu.com>
# Cross-checked 2026-11-16 (agent BV) in three independent places: (1) the `ubuntu-keyring` 2023.11.28.1 package (/usr/share/keyrings/ubuntu-archive-keyring.gpg,
# `dpkg --verify` clean; it also holds the 2012 archive key, deliberately NOT pinned: noble is not signed by it), (2) keyserver.ubuntu.com
# (`pks/lookup?op=get&search=0xF6ECB3762474EDA9D21B7022871920D1991BC93C` returns this exact primary key; keys/ubuntu-archive-automatic-2018.asc is that
# file), (3) the live https://archive.ubuntu.com/ubuntu/dists/noble/InRelease verifies ("Good signature", signing key = this fingerprint); the -updates and
# -security InRelease files fetched by every build must verify against the same pinned key or apt refuses. wiki.ubuntu.com/SecurityTeam/FAQ answered
# HTTP 503 on every attempt and was NOT used as a source.
# The earlier cloud-image mode (SHA256SUMS.gpg of cloud-images.ubuntu.com, key keys/ubuntu-uec-image-signing.asc, pin below) remains available as
# `recipe.sh ubuntu-24.04 verify-upstream`, only to cross-check the published upstream image; the golden image does not derive from it.
DISTRO=ubuntu
UPSTREAM_MODE=bootstrap
MIRROR=https://archive.ubuntu.com/ubuntu
SECURITY_MIRROR=https://archive.ubuntu.com/ubuntu
SUITE=noble
COMPONENTS="main universe"
SECURITY_SUITE=noble-security
KERNEL_PKG=linux-image-virtual
ARCHIVE_KEY_FPRS="F6ECB3762474EDA9D21B7022871920D1991BC93C"
ARCHIVE_KEY_FILES="ubuntu-archive-automatic-2018.asc"
UNATTENDED_ORIGIN='origin=Ubuntu,codename=${distro_codename}-security,label=Ubuntu'
# optional upstream-image cross-check (verify-upstream step; review 5 L7 dated pin rules apply)
UPSTREAM_BASE_ROOT=https://cloud-images.ubuntu.com/server/noble
UPSTREAM_SERIAL=${UPSTREAM_SERIAL:-}
UPSTREAM_MAX_AGE_DAYS=${UPSTREAM_MAX_AGE_DAYS:-60}
UPSTREAM_IMAGE=noble-server-cloudimg-amd64.img
UPSTREAM_SUMS=SHA256SUMS
UPSTREAM_SUMS_SIG=SHA256SUMS.gpg
UPSTREAM_SUM_TOOL=sha256sum
UPSTREAM_KEY_FPR=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
UPSTREAM_KEY_FILE=${UPSTREAM_KEY_FILE:-}
UPSTREAM_KEY_DEFAULT=ubuntu-uec-image-signing.asc

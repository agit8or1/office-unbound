# Ubuntu 24.04 (noble) cloud image. Not built yet (see docs/status/bootstrap-v2.md); same pinning rule as debian-12.env: pin the full fingerprint of the
# "Ubuntu Cloud Image Builder" signing key after verifying it out of band. `fetch` refuses to run while UPSTREAM_KEY_FPR is empty.
UPSTREAM_BASE=https://cloud-images.ubuntu.com/noble/current
UPSTREAM_IMAGE=noble-server-cloudimg-amd64.img
UPSTREAM_SUMS=SHA256SUMS
UPSTREAM_SUMS_SIG=SHA256SUMS.gpg
UPSTREAM_SUM_TOOL=sha256sum
UPSTREAM_KEY_FPR=
UPSTREAM_KEY_FILE=${UPSTREAM_KEY_FILE:-}

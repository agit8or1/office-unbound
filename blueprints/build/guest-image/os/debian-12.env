# Debian 12 (bookworm) genericcloud base image. The checksum file is signed by the Debian Cloud Team; PIN ITS FULL FINGERPRINT HERE after verifying the key
# out of band (never trust-on-first-use): `fetch` refuses to run while UPSTREAM_KEY_FPR is empty. UPSTREAM_KEY_FILE is the public key you verified.
UPSTREAM_BASE=https://cloud.debian.org/images/cloud/bookworm/latest
UPSTREAM_IMAGE=debian-12-genericcloud-amd64.qcow2
UPSTREAM_SUMS=SHA512SUMS
UPSTREAM_SUMS_SIG=SHA512SUMS.sign
UPSTREAM_SUM_TOOL=sha512sum
UPSTREAM_KEY_FPR=
UPSTREAM_KEY_FILE=${UPSTREAM_KEY_FILE:-}

#!/usr/bin/env python3
"""ou-image-sign: the ONLY code that touches the Office Unbound golden-image manifest signing key (same pattern as ou-release-sign, security review 4).

Runs as the dedicated system user `ou-imgsign`, invoked as `sudo -u ou-imgsign /usr/local/sbin/ou-image-sign <command>` (fixed sudoers rule, see
install-image-signer.sh). The ECDSA P-256 key is passphrase-protected; the passphrase file is readable by ou-imgsign only. The builder (which handles
untrusted build output) supplies everything on stdin as a tar stream; nothing the caller says about a hash is trusted:

  sign                         stdin: tar with exactly ou-golden-<os>-<YYYYMMDD>.qcow2 and ou-golden-<os>-<YYYYMMDD>.qcow2.sbom.cdx.json (regular files).
                               The signer RE-COMPUTES both SHA-256 values itself, REFUSES unless a passing `first-boot` test record exists for the image's
                               SHA-256 (record-test) and the SBOM is a CycloneDX document with a component inventory, builds the SHA256SUMS text itself (the
                               exact two-line form ics/guest/golden.py verifies) and prints a tar with SHA256SUMS and SHA256SUMS.sig (base64 DER ECDSA/SHA-256).
  record-test                  stdin: ONE attestation produced by `ou-test-attest run image-first-boot <image path>` (user ou-testrunner): the runner copied and hashed the image
                               itself and BOOTED it in the boot-proof machine (reviews 6 H1 / 7 H-3); the caller names the image and nothing else, there is no argument or
                               field through which a result or evidence can be supplied. Here: signature against the root-owned trust/test-runner.pub, v == 2, kind
                               image-first-boot, and `at` newer than any earlier record of this image. Takes no argument.
  pubkey                       prints the public key PEM and its SPKI SHA-256 pin (what the ICS operator confirms)
  sign-manifest                golden-image manifest v2 (docs/status/golden-image-prod-results.md "Signer contract"). stdin: tar with the image
                               ou-golden-<os>-<YYYYMMDD>.qcow2 and its .sbom.cdx.json, .packages.lock, .provenance.json and .attestation.json (a
                               manifest.json in the tar is IGNORED: the builder's manifest is never trusted). The signer re-hashes every file, verifies the
                               attestation (test-runner key, v2, image-first-boot, pass, THIS image sha256) and that the recorded first-boot result of the
                               image is that same passing attestation, applies the checks the ICS verifier applies (SBOM, package list, provenance), takes
                               the version from its own per-OS counter (last + 1), builds the canonical manifest itself and signs it with the RELEASE key
                               (release-key.pem, separate from the SHA256SUMS key). Prints a tar with manifest.json and manifest.json.sig.
  pubkey-release               the release key's public PEM and SPKI SHA-256 pin (ICS_GUEST_GOLDEN_RELEASE_PUBKEY_FILE / ..._PIN_SHA256)
State directory (default /var/lib/ou-imgsign, env OU_IMGSIGN_STATE for tests): key.pem, passphrase, release-key.pem, release-passphrase,
release-versions.json, records/, trust/ (root-owned).
Every command refuses extra arguments (the sudoers rule names each command exactly, no `*`).
"""
import base64
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tarfile

STATE = os.environ.get("OU_IMGSIGN_STATE", "/var/lib/ou-imgsign")
IMAGE_RE = re.compile(r"^ou-golden-(debian-12|ubuntu-24\.04)-\d{8}\.qcow2$")
MAXTOTAL = 6 * 1024 ** 3
MAXSBOM = 64 * 1024 * 1024
ATTEST_PREFIX = b"ou-test-attestation-v1\n"


def die(msg, code=3):
    print("REFUSED: " + msg, file=sys.stderr)
    sys.exit(code)


def canon(o):
    return json.dumps(o, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False).encode()


def trusted_runner_pub():
    """raw Ed25519 key (base64) of the test runner, from the root-owned trust directory (never writable by group/other, not owned by the build user)"""
    d = os.path.join(STATE, "trust")
    p = os.path.join(d, "test-runner.pub")
    try:
        st, dst = os.stat(p), os.stat(d)
    except OSError:
        die("no trusted test-runner key installed (trust/test-runner.pub): run install-image-signer.sh")
    if st.st_mode & 0o022 or dst.st_mode & 0o022:
        die("trust/test-runner.pub or its directory is group/world writable")
    if os.environ.get("OU_IMGSIGN_SANDBOX") != "1" and (st.st_uid != 0 or dst.st_uid != 0):
        die("trust/test-runner.pub must be owned by root")
    return open(p).read().strip()


def verify_attestation(att, sig):
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    try:
        Ed25519PublicKey.from_public_bytes(base64.b64decode(trusted_runner_pub(), validate=True)).verify(base64.b64decode(sig, validate=True), ATTEST_PREFIX + canon(att))
        return True
    except (InvalidSignature, ValueError, TypeError):
        return False


def read_tar(fp):
    """regular top-level files only; the image is hashed on the fly (never held in memory), the SBOM is kept"""
    hashes, sbom, total = {}, None, 0
    with tarfile.open(fileobj=fp, mode="r|*") as tf:
        for m in tf:
            if m.isdir() and m.name in (".", "./"):
                continue
            name = m.name[2:] if m.name.startswith("./") else m.name
            if not m.isreg() or "/" in name or name in hashes:
                die("tar member %r is not an acceptable regular file" % m.name)
            total += m.size
            if total > MAXTOTAL:
                die("tar too large")
            f = tf.extractfile(m)
            if name.endswith(".sbom.cdx.json"):
                if m.size > MAXSBOM:
                    die("SBOM too large")
                sbom = f.read()
                hashes[name] = hashlib.sha256(sbom).hexdigest()
            else:
                h = hashlib.sha256()
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
                hashes[name] = h.hexdigest()
    return hashes, sbom


def cmd_sign():
    files, sbom = read_tar(sys.stdin.buffer)
    images = [n for n in files if IMAGE_RE.match(n)]
    if len(images) != 1 or set(files) != {images[0], images[0] + ".sbom.cdx.json"}:
        die("the tar must hold exactly one ou-golden-<os>-<date>.qcow2 and its .sbom.cdx.json")
    img = images[0]
    try:
        r = json.load(open(os.path.join(STATE, "records", files[img] + ".json")))
    except (OSError, ValueError):
        die("no test record for image sha256 %s: run the first-boot proof and record-test first" % files[img])
    fb = r.get("results", {}).get("first-boot", {})
    if fb.get("result") != "pass":
        die("the recorded first-boot test of this image did not pass")
    att = fb.get("attestation")
    if not isinstance(att, dict) or att.get("sha256") != files[img] or att.get("kind") != "image-first-boot" or not verify_attestation(att, fb.get("sig", "")):
        die("the first-boot record carries no valid test-runner attestation for this image (a record the build user typed is not accepted)")
    try:
        bom = json.loads(sbom)
        ok = bom["bomFormat"] == "CycloneDX" and isinstance(bom.get("components"), list) and len(bom["components"]) > 50
    except (ValueError, KeyError, TypeError):
        ok = False
    if not ok:
        die("the SBOM is not a CycloneDX document with a component inventory")
    manifest = ("%s  %s\n%s  %s\n" % (files[img], img, files[img + ".sbom.cdx.json"], img + ".sbom.cdx.json")).encode()
    p = subprocess.run(["openssl", "dgst", "-sha256", "-sign", os.path.join(STATE, "key.pem"), "-passin", "file:" + os.path.join(STATE, "passphrase")],
                       input=manifest, capture_output=True)
    if p.returncode != 0:
        die("openssl failed: " + p.stderr.decode()[-200:], 4)
    bio = io.BytesIO()
    with tarfile.open(fileobj=bio, mode="w") as tf:
        for n, b in (("SHA256SUMS", manifest), ("SHA256SUMS.sig", base64.b64encode(p.stdout))):
            ti = tarfile.TarInfo(n)
            ti.size, ti.mode, ti.mtime = len(b), 0o644, 0
            tf.addfile(ti, io.BytesIO(b))
    sys.stdout.buffer.write(bio.getvalue())


MANIFEST_SCHEMA = "ou-golden-manifest-v2"
SMALL = {".sbom.cdx.json": MAXSBOM, ".packages.lock": 4 * 1024 * 1024, ".provenance.json": 1024 * 1024, ".attestation.json": 65536}
PKG_LINE = re.compile(r"[a-z0-9][a-z0-9+.\-]*=[A-Za-z0-9.+:~\-]+")
HEX64 = re.compile(r"[0-9a-f]{64}")


def read_release_tar(fp):
    """the image is hashed on the fly (size counted); the four small files are kept; anything else (except an ignored manifest.json) is refused"""
    img = None
    small, total = {}, 0
    with tarfile.open(fileobj=fp, mode="r|*") as tf:
        for m in tf:
            if m.isdir() and m.name in (".", "./"):
                continue
            name = m.name[2:] if m.name.startswith("./") else m.name
            if not m.isreg() or "/" in name or name in small or (img and name == img[0]):
                die("tar member %r is not an acceptable regular file" % m.name)
            total += m.size
            if total > MAXTOTAL:
                die("tar too large")
            f = tf.extractfile(m)
            if name in ("manifest.json", "manifest.json.sig"):
                f.read()                       # the builder's manifest is never trusted: ignored
                continue
            if IMAGE_RE.match(name):
                if img:
                    die("more than one image in the tar")
                h, n = hashlib.sha256(), 0
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
                    n += len(chunk)
                img = (name, h.hexdigest(), n)
                continue
            suf = next((x for x in SMALL if name.endswith(x)), None)
            if suf is None or m.size > SMALL[suf]:
                die("unexpected or oversized file %r" % name)
            small[name] = f.read()
    if not img:
        die("no ou-golden-<os>-<date>.qcow2 image in the tar")
    want = {img[0] + x for x in SMALL}
    if set(small) != want:
        die("the tar must hold exactly the image and its %s" % ", ".join(sorted(SMALL)))
    return img, {x: small[img[0] + x] for x in SMALL}


def next_version(os_id, commit=None):
    p = os.path.join(STATE, "release-versions.json")
    try:
        d = json.load(open(p))
    except FileNotFoundError:
        d = {}
    except ValueError:
        die("release-versions.json is corrupt: refusing to guess a version")
    if commit is None:
        last = d.get(os_id, 0)
        if type(last) is not int or last < 0:
            die("release-versions.json is corrupt: refusing to guess a version")
        return last + 1
    d[os_id] = commit
    tmp = p + ".new"
    with open(tmp, "w") as f:
        f.write(json.dumps(d, sort_keys=True))
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, p)


def cmd_sign_manifest():
    (name, isha, isize), f = read_release_tar(sys.stdin.buffer)
    os_id = IMAGE_RE.match(name).group(1)
    try:
        doc = json.loads(f[".attestation.json"])
        att, asig = doc["attestation"], doc["sig"]
    except (ValueError, KeyError, TypeError):
        die("the attestation file is not an ou-test-attest document")
    if (not isinstance(att, dict) or att.get("v") != 2 or att.get("kind") != "image-first-boot" or att.get("name") != "first-boot" or att.get("sha256") != isha
            or att.get("result") != "pass" or not isinstance(att.get("at"), int) or not isinstance(asig, str) or not verify_attestation(att, asig)):
        die("the attestation is not a passing image-first-boot attestation of THIS image signed by the registered test runner")
    try:
        rec = json.load(open(os.path.join(STATE, "records", isha + ".json")))["results"]["first-boot"]
    except (OSError, ValueError, KeyError, TypeError):
        die("no recorded first-boot test for image sha256 %s: run record-test with the runner's attestation first" % isha)
    if rec.get("result") != "pass" or rec.get("attestation_sha256") != hashlib.sha256(canon(att)).hexdigest():
        die("the latest recorded first-boot test of this image is not this passing attestation (a later failure blocks signing)")
    try:
        bom = json.loads(f[".sbom.cdx.json"])
        ok = bom["bomFormat"] == "CycloneDX" and isinstance(bom.get("components"), list) and len(bom["components"]) >= 50
    except (ValueError, KeyError, TypeError):
        ok = False
    if not ok:
        die("the SBOM is not a CycloneDX document with a component inventory")
    try:
        lines = [l for l in f[".packages.lock"].decode("ascii").splitlines() if l.strip()]
    except UnicodeDecodeError:
        die("the package list is not ASCII")
    if not lines or any(not PKG_LINE.fullmatch(l) for l in lines) or lines != sorted(set(lines)):
        die("the package list is malformed or unsorted")
    psha = hashlib.sha256(f[".packages.lock"]).hexdigest()
    try:
        pv = json.loads(f[".provenance.json"])
        epoch = pv["source_date_epoch"]
        ok = (pv["os"] == os_id and type(epoch) is int and epoch >= 1_000_000_000 and pv["package_lock_sha256"] == psha
              and HEX64.fullmatch(str(pv["recipe_sha256"])) and pv.get("archive_inrelease_sha256"))
    except (ValueError, KeyError, TypeError):
        ok = False
    if not ok:
        die("the provenance is missing fields or disagrees with the image (os, epoch, package-list hash, recipe hash)")
    if att["at"] < epoch:
        die("the boot test is older than the build")
    version = next_version(os_id)
    man = {"schema": MANIFEST_SCHEMA, "name": name, "os": os_id, "version": version, "created_at": epoch,
           "image": {"file": name, "sha256": isha, "size": isize},
           "packages": {"file": name + ".packages.lock", "sha256": psha, "count": len(lines)},
           "sbom": {"file": name + ".sbom.cdx.json", "sha256": hashlib.sha256(f[".sbom.cdx.json"]).hexdigest()},
           "provenance": {"file": name + ".provenance.json", "sha256": hashlib.sha256(f[".provenance.json"]).hexdigest(), "source_date_epoch": epoch,
                          "recipe_sha256": pv["recipe_sha256"], "package_lock_sha256": psha},
           "boot_test": {"attestation": att, "sig": asig, "attestation_sha256": hashlib.sha256(canon(att)).hexdigest()}}
    body = canon(man) + b"\n"                  # exactly what manifest.py writes and ics/guest/golden.py verifies (canonical JSON + newline)
    p = subprocess.run(["openssl", "dgst", "-sha256", "-sign", os.path.join(STATE, "release-key.pem"), "-passin", "file:" + os.path.join(STATE, "release-passphrase")],
                       input=body, capture_output=True)
    if p.returncode != 0:
        die("openssl failed (is the release key installed? install-image-signer.sh): " + p.stderr.decode()[-200:], 4)
    next_version(os_id, version)                # the counter only advances once the signature exists
    bio = io.BytesIO()
    with tarfile.open(fileobj=bio, mode="w") as tf:
        for n, b in (("manifest.json", body), ("manifest.json.sig", base64.b64encode(p.stdout))):
            ti = tarfile.TarInfo(n)
            ti.size, ti.mode, ti.mtime = len(b), 0o644, 0
            tf.addfile(ti, io.BytesIO(b))
    sys.stdout.buffer.write(bio.getvalue())
    print("signed %s version %d (manifest sha256 %s)" % (name, version, hashlib.sha256(body).hexdigest()[:16]), file=sys.stderr)


def cmd_record():
    """stdin = {"attestation": {...}, "sig": base64}; produced by `ou-test-attest run image-first-boot` under the runner identity"""
    try:
        doc = json.loads(sys.stdin.buffer.read(65536))
        att, sig = doc["attestation"], doc["sig"]
        sha, name, res, logsha = att["sha256"], att["name"], att["result"], att["log_sha256"]
    except (ValueError, KeyError, TypeError):
        die("bad attestation")
    if not isinstance(att, dict) or att.get("v") != 2 or att.get("kind") != "image-first-boot" or name != "first-boot" or not isinstance(att.get("at"), int):
        die("not an image first-boot attestation (version 2, produced by the test runner's own boot test)")
    if not re.fullmatch(r"[0-9a-f]{64}", str(sha)) or res not in ("pass", "fail") or not re.fullmatch(r"[0-9a-f]{64}", str(logsha)):
        die("bad attestation fields")
    if not isinstance(sig, str) or not verify_attestation(att, sig):
        die("attestation is not signed by the registered test runner")
    d = os.path.join(STATE, "records")
    os.makedirs(d, exist_ok=True)
    fn = os.path.join(d, sha + ".json")
    rec = json.load(open(fn)) if os.path.exists(fn) else {"sha256": sha, "results": {}}
    old = rec["results"].get(name, {}).get("attestation", {}).get("at")
    if isinstance(old, int) and att["at"] <= old:
        die("a newer (or equal) first-boot attestation for this image is already recorded (an old pass can not replace a later fail)")
    rec["results"][name] = {"result": res, "log_sha256": logsha, "attestation": att, "sig": sig, "attestation_sha256": hashlib.sha256(canon(att)).hexdigest(), "runner": "ou-test-attest", "run_id": att.get("run_id", "")}
    open(fn, "w").write(json.dumps(rec, sort_keys=True))
    print("recorded %s=%s for %s (attestation %s)" % (name, res, sha, rec["results"][name]["attestation_sha256"][:16]), file=sys.stderr)


def cmd_pubkey(key="key.pem", pp="passphrase"):
    k = ["-passin", "file:" + os.path.join(STATE, pp)]
    pem = subprocess.run(["openssl", "ec", "-in", os.path.join(STATE, key), *k, "-pubout"], capture_output=True, check=True).stdout
    der = subprocess.run(["openssl", "pkey", "-pubin", "-outform", "DER"], input=pem, capture_output=True, check=True).stdout
    sys.stdout.write(pem.decode() + "# spki-sha256 pin: " + hashlib.sha256(der).hexdigest() + "\n")


def main():
    a = sys.argv[1:]
    os.umask(0o022)
    if a == ["sign"]:
        cmd_sign()
    elif a == ["record-test"]:
        cmd_record()
    elif a == ["pubkey"]:
        cmd_pubkey()
    elif a == ["sign-manifest"]:
        cmd_sign_manifest()
    elif a == ["pubkey-release"]:
        cmd_pubkey("release-key.pem", "release-passphrase")
    else:
        print(__doc__)
        sys.exit(2)


main()

Description: Rebrand user-visible product name, page title and web manifest
 Default WEBAPP_TITLE, fallback title, version banner, PWA manifest name, desktop
 app title and the logo aria-label say "Office Unbound Web" instead of the
 trademarked "grommunio Web". Logos and icons are replaced at package build time
 from debian/branding (binary files cannot be carried in a quilt patch).
 Upstream copyright/SPDX headers are untouched.
Author: Office Unbound
Forwarded: not-needed
Last-Update: 2026-11-15

diff -ruN a/config.php.dist b/config.php.dist
--- a/config.php.dist
+++ b/config.php.dist
@@ -140,7 +140,7 @@
 	//define("THEME", 'grommunioLighttheme');
 
 	// The title that will be shown in the title bar of the browser
-	define("WEBAPP_TITLE", "grommunio Web");
+	define("WEBAPP_TITLE", "Office Unbound Web");
 
 	// Enable widgets/today context.
 	// Overrides defaults.php
diff -ruN a/index.php b/index.php
--- a/index.php
+++ b/index.php
@@ -55,7 +55,7 @@
 }
 $webappTitle = Theming::getBrand()['title'] ?? '';
 if ($webappTitle === '') {
-	$webappTitle = defined('WEBAPP_TITLE') && WEBAPP_TITLE ? WEBAPP_TITLE : 'grommunio Web';
+	$webappTitle = defined('WEBAPP_TITLE') && WEBAPP_TITLE ? WEBAPP_TITLE : 'Office Unbound Web';
 }
 // If the user wants to logout (and is not using single-signon)
 // then destroy the session and redirect to this page, so the login page
@@ -135,7 +135,7 @@
 	}
 
 	// Set some template variables for the login page
-	$version = 'grommunio Web ' . trim(file_get_contents('version'));
+	$version = 'Office Unbound Web ' . trim(file_get_contents('version'));
 	$user = sanitizeGetValue('user', '', USERNAME_REGEX);
 
 	$url = '?logon';

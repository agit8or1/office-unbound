diff --git a/engine/distro-configs/OfficeUnbound-LOKit.conf b/engine/distro-configs/OfficeUnbound-LOKit.conf
new file mode 100644
index 000000000..95880d13b
--- /dev/null
+++ b/engine/distro-configs/OfficeUnbound-LOKit.conf
@@ -0,0 +1,24 @@
+# Engine configure switches for the Office Unbound Docs build (derived from CPLinux-LOKit.conf)
+# builds the engine in-tree with ./autogen.sh
+# --with-distro=CPLinux-LOKit). The language list comes from
+# Langs.conf via the INCLUDE below, so it is never duplicated here.
+
+# pull in shared config
+INCLUDE:OfficeUnboundCommon
+INCLUDE:Langs
+
+# enable features for Online release build
+--enable-sal-log
+--with-myspell-dicts
+--with-external-dict-dir=/usr/share/hunspell
+--with-external-hyph-dir=/usr/share/hyphen
+--with-external-thes-dir=/usr/share/mythes
+
+# use internal libraries
+--without-system-curl
+--without-system-expat
+--without-system-fontconfig
+--without-system-freetype
+--without-system-graphite
+--without-system-harfbuzz
+--without-system-icu
diff --git a/engine/distro-configs/OfficeUnboundCommon.conf b/engine/distro-configs/OfficeUnboundCommon.conf
new file mode 100644
index 000000000..ce3ebea86
--- /dev/null
+++ b/engine/distro-configs/OfficeUnboundCommon.conf
@@ -0,0 +1,28 @@
+# Office Unbound: shared linux config (derived from CPLinuxCommon.conf, vendor+branding changed)
+# CPLinuxQtFlatpak, CPFreeBSDQt, CPLinux-LOKit, and CPLinux-LOKit-Dev
+--disable-dbus
+--disable-gio
+--disable-gtk3
+--disable-gui
+--disable-randr
+
+--enable-cairo-rgba
+--enable-hardening-flags
+--enable-ld
+--enable-mergelibs
+--enable-quickjs
+--enable-symbols
+
+--with-buildconfig-recorded
+--with-fonts
+--with-galleries=no
+--with-linker-hash-style=both
+--with-theme=colibre colibre_svg
+--with-vendor=Office Unbound
+--without-help
+--without-junit
+--with-system-dicts
+--with-system-zlib
+--without-system-cairo
+--without-system-jpeg
+--without-templates

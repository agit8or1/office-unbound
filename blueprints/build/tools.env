# Pinned build-environment inputs for blueprints/build (ADR-0008). Every binary is checksum-verified before use.
# Checksums are the vendor-published ones (release checksum files), re-verified locally 2026-11-15.
SYFT_VERSION=1.57.1
SYFT_URL=https://github.com/anchore/syft/releases/download/v1.57.1/syft_1.57.1_linux_amd64.tar.gz
SYFT_SHA256=bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c
OSV_VERSION=2.7.1
OSV_URL=https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_linux_amd64
OSV_SHA256=fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8
# Builder / tester machines (systemd-nspawn, cloned from the Debian 12 base image, zone oulab)
BUILDER=ou-pkg1
BUILDER_BASE=ou-base-bookworm
BUILDER_MEM=3G
BUILDER_JOBS=3
TESTER=ou-pkgtest1
TESTER_MEM=2G
# Debian version suffix for our builds ("<upstream>-ou<N>"); bump N when only our packaging/patches change
OU_REVISION=ou1
# Node.js for grommunio-web: Debian 12 ships Node 18 (too old for web 5.x). Official nodesource apt repo (authorized endpoint),
# repo signing key pinned by fingerprint below, package version pinned.
NODESOURCE_KEY_URL=https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key
NODESOURCE_KEY_FPR=6F71F525282841EEDAF851B42F59B5F99B1BE0B4
NODE_PKG_VERSION=22.23.5-1nodesource1

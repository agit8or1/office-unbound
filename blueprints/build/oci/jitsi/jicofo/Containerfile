# Office Unbound: Jicofo 1.0-1205-1 (jar + libs extracted from the pinned, signature-chain-verified .deb; maintainer scripts never run) on the Ubuntu noble OpenJDK 17 JRE headless. uid 10100.
# Config: mount /etc/jitsi/jicofo/jicofo.conf (HOCON) -- the entrypoint passes -Dconfig.file. No analytics handlers are configured; jicofo has no update check.
ARG BASE=localhost/ou-base-noble:latest
FROM ${BASE}
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o APT::Sandbox::User=root update && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends openjdk-17-jre-headless ca-certificates \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
 && groupadd -g 10100 jicofo && useradd -u 10100 -g 10100 -d /nonexistent -M -s /usr/sbin/nologin jicofo
COPY jicofo/ /usr/share/jicofo/
COPY logging.properties /etc/jitsi/jicofo/logging.properties
COPY entrypoint.sh /usr/local/bin/ou-jicofo-entrypoint
RUN chmod -R a+rX /usr/share/jicofo /etc/jitsi && chmod 0755 /usr/local/bin/ou-jicofo-entrypoint /usr/share/jicofo/jicofo.sh
LABEL org.opencontainers.image.title="Jicofo (Office Unbound build)" org.opencontainers.image.version="1.0-1205-1" org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://download.jitsi.org/stable/jicofo_1.0-1205-1_all.deb"
USER 10100:10100
EXPOSE 8888
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD ["bash","-c","exec 3<>/dev/tcp/127.0.0.1/8888 && printf 'GET /about/health HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["/usr/local/bin/ou-jicofo-entrypoint"]

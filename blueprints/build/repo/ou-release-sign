#!/usr/bin/env python3
"""ou-release-sign: the ONLY code that touches the Office Unbound release signing key (security review 4: H2, M7, M8).

Runs as the dedicated system user `ou-release` (no login shell), invoked as `sudo -u ou-release /usr/local/sbin/ou-release-sign <command>` (fixed sudoers rule,
see install-signer.sh). The key lives in the user's own GnuPG home, protected by a passphrase kept in a root/ou-release-only file. Everything the caller
(the build host user, who also handles untrusted build output) supplies arrives on stdin as a tar stream and is validated here:

  sign <suite>                 stdin: tar of dists/<suite> (Release + Packages/Sources). Verifies the index hashes, REFUSES unless every pool file named
                               in Packages/Sources is in the suite's ledger (= was admitted/promoted through this program), sets Date and Valid-Until
                               (default 14 days) itself and prints a tar with Release, InRelease, Release.gpg.
  admit dev                    stdin: tar of one component's pool files (.deb/.dsc/tarballs, regular files only, parsed here): adds them to the dev ledger.
  record-test <sha256> <name> <pass|fail> <log-sha256>
                               writes the test record of one .deb (records/<sha256>.json).
  promote <from> <to> <approver>
                               stdin: tar of the component's pool files in <from>. dev>staging or staging>stable only; every .deb needs a passing
                               `install-smoke` record, every file must be in the <from> ledger, stable needs a named approver; adds the files to the <to>
                               ledger and writes a clearsigned promotion record (promotions/*.asc).
  status                       prints counts.
State directory (default /var/lib/ou-release, env OU_RELEASE_STATE for tests): gnupg/, passphrase, ledger/<suite>.sha256, records/, promotions/.
"""
import datetime
import hashlib
import io
import json
import os
import re
import stat
import subprocess
import sys
import tarfile

STATE = os.environ.get("OU_RELEASE_STATE", "/var/lib/ou-release")
GNUPG = os.path.join(STATE, "gnupg")
PASSF = os.path.join(STATE, "passphrase")
VALID_DAYS = int(os.environ.get("OU_VALID_DAYS", "14"))
SUITES = ("dev", "staging", "stable")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+~-]{0,200}$")
MAXMEM = 4 * 1024 * 1024 * 1024
POOL_RE = re.compile(r"^(ou-[a-z0-9.+-]+_[A-Za-z0-9.+~:-]+(_amd64|_all)\.deb|ou-[a-z0-9.+-]+_[A-Za-z0-9.+~:-]+\.dsc|ou-[a-z0-9.+-]+_[A-Za-z0-9.+~:-]+\.(orig|debian)?\.?tar\.(xz|gz|zst|bz2))$")
FIELD_RE = re.compile(r"^([A-Za-z0-9-]+):[ \t]*(.*)$")


def die(msg, code=3):
    print("REFUSED: " + msg, file=sys.stderr)
    sys.exit(code)


def sha256(b):
    return hashlib.sha256(b).hexdigest()


def read_tar(fp, flat=True):
    """regular files only; no links, devices, directories except '.', no absolute or nested paths when flat. Returns {name: bytes}."""
    out = {}
    total = 0
    with tarfile.open(fileobj=fp, mode="r|*") as tf:
        for m in tf:
            if m.isdir() and (m.name in (".", "./") or (not flat and not m.name.startswith("/") and ".." not in m.name.split("/"))):
                continue
            if not m.isreg() or m.islnk() or m.issym():
                die("tar member %r is not a regular file" % m.name)
            name = m.name[2:] if m.name.startswith("./") else m.name
            if flat and not NAME_RE.match(name):
                die("tar member name %r not allowed" % name)
            if not flat and (name.startswith("/") or ".." in name.split("/") or "\0" in name):
                die("tar member name %r not allowed" % name)
            total += m.size
            if total > MAXMEM:
                die("tar too large")
            if name in out:
                die("duplicate member %r" % name)
            out[name] = tf.extractfile(m).read()
    return out


def write_tar(files):
    bio = io.BytesIO()
    with tarfile.open(fileobj=bio, mode="w") as tf:
        for n, b in sorted(files.items()):
            ti = tarfile.TarInfo(n)
            ti.size = len(b)
            ti.mode = 0o644
            ti.mtime = 0
            tf.addfile(ti, io.BytesIO(b))
    return bio.getvalue()


def deb_fields(blob):
    """control fields of a .deb via dpkg-deb (stdin-free: written to a private temp file)"""
    import tempfile
    with tempfile.NamedTemporaryFile(prefix="ou-rel-", suffix=".deb") as t:
        t.write(blob)
        t.flush()
        r = subprocess.run(["dpkg-deb", "-f", t.name], capture_output=True, text=True)
    if r.returncode != 0:
        die("not a valid .deb (dpkg-deb -f failed)")
    d = {}
    for ln in r.stdout.splitlines():
        m = FIELD_RE.match(ln)
        if m:
            d[m.group(1)] = m.group(2)
    return d


def check_pool_files(files):
    """names + content sanity of pool files; .deb parsed with dpkg-deb; .dsc must list every tarball of the set with matching sha256."""
    dsc_listed = {}
    for n, b in files.items():
        if not POOL_RE.match(n):
            die("pool file name %r not allowed" % n)
        if n.endswith(".deb"):
            f = deb_fields(b)
            if not f.get("Package", "").startswith("ou-") or not f.get("Version") or f.get("Architecture") not in ("amd64", "all"):
                die("%s: control fields not acceptable (Package/Version/Architecture)" % n)
            if not n.startswith(f["Package"] + "_"):
                die("%s: file name does not match control Package %s" % (n, f["Package"]))
        if n.endswith(".dsc"):
            txt = b.decode("utf8", "replace")
            sec = re.search(r"^Checksums-Sha256:\n((?: .*\n?)+)", txt, re.M)
            if not sec:
                die("%s: no Checksums-Sha256" % n)
            for ln in sec.group(1).splitlines():
                p = ln.split()
                if len(p) == 3:
                    dsc_listed[p[2]] = p[0]
    for n, b in files.items():
        if re.search(r"\.tar\.", n):
            if dsc_listed.get(n) != sha256(b):
                die("%s: not listed in (or hash differs from) the .dsc of the same set" % n)


def ledger_path(suite):
    return os.path.join(STATE, "ledger", suite + ".sha256")


def ledger(suite):
    try:
        return set(l.split()[0] for l in open(ledger_path(suite)) if l.strip())
    except FileNotFoundError:
        return set()


def ledger_add(suite, files):
    os.makedirs(os.path.dirname(ledger_path(suite)), exist_ok=True)
    have = ledger(suite)
    with open(ledger_path(suite), "a") as f:
        for n, b in sorted(files.items()):
            h = sha256(b)
            if h not in have:
                f.write("%s  %s  %s\n" % (h, n, datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).strftime("%Y-%m-%dT%H:%M:%SZ")))


def gpg(args, inp):
    fpr = open(os.path.join(STATE, "FINGERPRINT")).read().strip()
    cmd = ["gpg", "--homedir", GNUPG, "--batch", "--yes", "--pinentry-mode", "loopback", "--passphrase-file", PASSF, "--local-user", fpr] + args
    r = subprocess.run(cmd, input=inp, capture_output=True)
    if r.returncode != 0:
        die("gpg failed: " + r.stderr.decode()[-200:], 4)
    return r.stdout


def parse_release_hashes(txt):
    m = re.search(r"^SHA256:\n((?: .*\n?)+)", txt, re.M)
    if not m:
        die("Release has no SHA256 section")
    out = {}
    for ln in m.group(1).splitlines():
        p = ln.split()
        if len(p) == 3:
            out[p[2]] = (p[0], int(p[1]))
    return out


def stanzas(text):
    for st in re.split(r"\n\n+", text.strip("\n")):
        d, cur = {}, None
        for ln in st.split("\n"):
            if ln.startswith((" ", "\t")) and cur:
                d[cur] += "\n" + ln
            else:
                m = FIELD_RE.match(ln)
                if m:
                    cur = m.group(1)
                    d[cur] = m.group(2)
        if d:
            yield d


def cmd_sign(suite):
    if suite not in SUITES:
        die("unknown suite")
    t = read_tar(sys.stdin.buffer, flat=False)
    if "Release" not in t:
        die("no Release in tar")
    # apt-ftparchive lists the PREVIOUS Release/InRelease/Release.gpg of the directory in the hash sections: those never belong there, drop them
    rel = "\n".join(l for l in t["Release"].decode().split("\n") if l.split()[-1:] not in (["Release"], ["InRelease"], ["Release.gpg"]) or not l.startswith(" "))
    hashes = parse_release_hashes(rel)
    for path, (h, size) in hashes.items():
        if path in t and (sha256(t[path]) != h or len(t[path]) != size):
            die("Release hash of %s does not match the supplied file" % path)
    pk = [p for p in t if p.endswith("/Packages")]
    sr = [p for p in t if p.endswith("/Sources")]
    if not pk or not sr:
        die("Packages and Sources are required")
    for p in pk + sr:
        if p not in hashes:
            die("%s not listed in Release" % p)
    need = {}
    for p in pk:
        for st in stanzas(t[p].decode()):
            need[st["Filename"].split("/")[-1]] = st["SHA256"]
    for p in sr:
        for st in stanzas(t[p].decode()):
            for ln in st.get("Checksums-Sha256", "").splitlines():
                q = ln.split()
                if len(q) == 3:
                    need[q[2]] = q[0]
    allowed = ledger(suite)
    bad = sorted(n for n, h in need.items() if h not in allowed)
    if bad:
        die("suite %s lists files that were never admitted/promoted into it: %s" % (suite, ", ".join(bad[:5])))
    now = datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
    hdr, rest = rel.split("\nMD5Sum:", 1) if "\nMD5Sum:" in rel else rel.split("\nSHA256:", 1)
    marker = "\nMD5Sum:" if "\nMD5Sum:" in rel else "\nSHA256:"
    hdr = "\n".join(l for l in hdr.split("\n") if not l.startswith(("Date:", "Valid-Until:")))
    fmt = "%a, %d %b %Y %H:%M:%S UTC"
    hdr += "\nDate: %s\nValid-Until: %s" % (now.strftime(fmt), (now + datetime.timedelta(days=VALID_DAYS)).strftime(fmt))
    rel2 = (hdr + marker + rest).encode()
    out = {"Release": rel2,
           "InRelease": gpg(["--clearsign"], rel2),
           "Release.gpg": gpg(["--armor", "--detach-sign"], rel2)}
    sys.stdout.buffer.write(write_tar(out))


def cmd_admit(suite):
    if suite != "dev":
        die("admit is only for dev (staging/stable go through promote)")
    files = read_tar(sys.stdin.buffer)
    check_pool_files(files)
    ledger_add("dev", files)
    print("admitted %d files to dev" % len(files), file=sys.stderr)


def cmd_record(sha, name, res, logsha):
    if not re.match(r"^[0-9a-f]{64}$", sha) or res not in ("pass", "fail") or not re.match(r"^[a-z0-9-]{1,40}$", name) or not re.match(r"^[0-9a-f]{64}$", logsha):
        die("bad arguments")
    d = os.path.join(STATE, "records")
    os.makedirs(d, exist_ok=True)
    fn = os.path.join(d, sha + ".json")
    rec = json.load(open(fn)) if os.path.exists(fn) else {"sha256": sha, "results": {}}
    rec["results"][name] = {"result": res, "log_sha256": logsha, "at": datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).strftime("%Y-%m-%dT%H:%M:%SZ"), "recorded_by_uid": os.environ.get("SUDO_UID", "")}
    json.dump(rec, open(fn, "w"), indent=1)
    print("recorded %s=%s" % (name, res), file=sys.stderr)


def cmd_promote(frm, to, approver):
    if (frm, to) not in (("dev", "staging"), ("staging", "stable")):
        die("only dev>staging or staging>stable")
    if to == "stable" and not re.match(r"^[A-Za-z0-9 ._()@:/-]{3,100}$", approver or ""):
        die("promotion to stable needs a named approver")
    files = read_tar(sys.stdin.buffer)
    if not files:
        die("empty set")
    check_pool_files(files)
    src = ledger(frm)
    for n, b in files.items():
        if sha256(b) not in src:
            die("%s is not in the %s ledger (was never admitted/promoted there)" % (n, frm))
        if n.endswith(".deb"):
            rf = os.path.join(STATE, "records", sha256(b) + ".json")
            try:
                r = json.load(open(rf))["results"].get("install-smoke", {}).get("result")
            except (OSError, ValueError):
                r = None
            if r != "pass":
                die("%s has no passing install-smoke test record (got %r)" % (n, r))
    ledger_add(to, files)
    now = datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).strftime("%Y%m%dT%H%M%SZ")
    rec = json.dumps({"from": frm, "to": to, "approved_by": approver or "", "at": now, "files": {n: sha256(b) for n, b in sorted(files.items())}}, indent=1, sort_keys=True).encode()
    os.makedirs(os.path.join(STATE, "promotions"), exist_ok=True)
    comp = sorted(n for n in files if n.endswith(".dsc"))[0].split("_")[0] if any(n.endswith(".dsc") for n in files) else "x"
    open(os.path.join(STATE, "promotions", "%s-%s-%s.json.asc" % (now, to, comp)), "wb").write(gpg(["--clearsign"], rec))
    print("promoted %d files %s>%s" % (len(files), frm, to), file=sys.stderr)


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__)
        sys.exit(2)
    c = a[0]
    os.umask(0o022)
    if c == "sign" and len(a) == 2:
        cmd_sign(a[1])
    elif c == "admit" and len(a) == 2:
        cmd_admit(a[1])
    elif c == "record-test" and len(a) == 5:
        cmd_record(*a[1:])
    elif c == "promote" and len(a) in (3, 4):
        cmd_promote(a[1], a[2], a[3] if len(a) == 4 else "")
    elif c == "status":
        for s in SUITES:
            print(s, len(ledger(s)))
    else:
        die("usage: see the header of this file", 2)


main()

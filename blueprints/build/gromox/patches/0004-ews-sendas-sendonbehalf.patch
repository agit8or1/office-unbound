OU patch 0004: EWS send-as / send-on-behalf. config/sendas.txt is honoured by EWS (was denied); delegates.txt / folder-ACL Send bit = on-behalf with a Sender header.
Apply with patch -p1 from the Gromox 3.13 source root after 0003.

--- a/exch/ews/context.cpp
+++ b/exch/ews/context.cpp
@@ -3788,9 +3788,66 @@
 		return; /* alias of the caller's own mailbox */
 	uint32_t permission = 0;
 	if (!m_plugin.exmdb.get_mbox_perm(maildir.c_str(),
-	    m_auth_info.username, &permission) ||
-	    !(permission & (frightsGromoxSendAs | frightsGromoxStoreOwner)))
+	    m_auth_info.username, &permission))
 		throw EWSError::AccessDenied(E3474);
+	if (permission & (frightsGromoxSendAs | frightsGromoxStoreOwner))
+		return;
+	/* OU: config/sendas.txt (the Send-As list admin tools write) is honoured, like zcore/emsmdb do */
+	if (!in_sendas_list(maildir))
+		throw EWSError::AccessDenied(E3474);
+}
+
+/**
+ * @brief      Is the caller on the Send-As list (config/sendas.txt) of a mailbox?
+ *
+ * @param      maildir   Store directory of the identity being claimed
+ */
+bool EWSContext::in_sendas_list(const std::string &maildir) const
+{
+	std::vector<std::string> list;
+	if (!m_plugin.exmdb.read_delegates(maildir.c_str(), 1, &list))
+		return false;
+	for (const auto &d : list)
+		if (strcasecmp(d.c_str(), m_auth_info.username) == 0 ||
+		    mysql_adaptor_check_mlist_include(d.c_str(), m_auth_info.username))
+			return true;
+	return false;
+}
+
+/**
+ * @brief      Does the message claim an identity the caller may only use "on behalf of"?
+ *
+ * True when the representing identity is a foreign mailbox for which the caller
+ * has a delegate grant (delegates.txt / folder ACL Send bit) but is neither the
+ * store owner nor on config/sendas.txt. Such a message must carry the caller as
+ * Sender (From: delegator, Sender: caller), like the MAPI submit path does. Never
+ * throws: validate_sendas_perms decides about denial.
+ */
+bool EWSContext::is_send_on_behalf(const MESSAGE_CONTENT &content) const
+{
+	auto &pl = content.proplist;
+	std::string identity;
+	if (auto a = pl.get<const char>(PR_SENT_REPRESENTING_SMTP_ADDRESS)) {
+		identity = a;
+	} else if (auto e = pl.get<const char>(PR_SENT_REPRESENTING_EMAIL_ADDRESS)) {
+		auto t = pl.get<const char>(PR_SENT_REPRESENTING_ADDRTYPE);
+		identity = t != nullptr && strcasecmp(t, "EX") == 0 ? essdn_to_username(e) : e;
+	}
+	if (identity.empty() || strcasecmp(identity.c_str(), m_auth_info.username) == 0)
+		return false;
+	try {
+		auto maildir = get_maildir(identity);
+		if (maildir == m_auth_info.maildir)
+			return false;
+		uint32_t permission = 0;
+		if (!m_plugin.exmdb.get_mbox_perm(maildir.c_str(),
+		    m_auth_info.username, &permission) ||
+		    (permission & frightsGromoxStoreOwner) || in_sendas_list(maildir))
+			return false;
+		return permission & frightsGromoxSendAs;
+	} catch (...) {
+		return false;
+	}
 }
 

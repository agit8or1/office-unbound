+/* Was a USER-KICK for this session's user received after the session authenticated? */
+bool imap_parser_user_kicked(const imap_context &ctx)
+{
+	if (!ctx.is_authed() || ctx.auth_time == time_point{})
+		return false;
+	std::string user = ctx.username;
+	HX_strlower(user.data());
+	std::lock_guard kl(g_kick_lock);
+	auto it = g_kicked_users.find(user);
+	return it != g_kicked_users.end() && it->second >= ctx.auth_time;
+}

--- a/include/gromox/bearer.hpp
+++ b/include/gromox/bearer.hpp
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 grommunio GmbH
+// This file is part of Gromox.
+#pragma once
+#include <ctime>
+#include <string>
+#include <string_view>
+#include <json/value.h>
+
+namespace gromox {
+
+/**
+ * Policy for OIDC bearer tokens (JWT) presented to authmgr. Empty strings
+ * mean "do not check", which is the historic behavior.
+ */
+struct bearer_policy {
+	std::string issuer;   /* required value of "iss" */
+	std::string audience; /* must be "aud" (string) or one element of "aud" (array) */
+};
+
+/**
+ * Validate the claims of an already signature-verified JWT. This does not
+ * check the signature itself.
+ * @hdr:	decoded JOSE header
+ * @claims:	decoded payload
+ * @now:	current time, in seconds since the epoch
+ *
+ * The token is rejected when:
+ * - the JOSE "alg" is anything but "RS256" (the only algorithm the signature
+ *   code implements; "none" and HMAC variants must never be accepted),
+ * - "exp" is missing, not a number, or in the past; "nbf" is in the future,
+ * - "email" (the account name) is missing or empty,
+ * - an issuer is configured and "iss" differs,
+ * - an audience is configured and "aud" does not contain it.
+ */
+inline bool bearer_claims_valid(const Json::Value &hdr, const Json::Value &claims,
+    const bearer_policy &pol, time_t now)
+{
+	if (!hdr.isObject() || !claims.isObject())
+		return false;
+	if (!hdr["alg"].isString() || hdr["alg"].asString() != "RS256")
+		return false;
+	if (!claims["exp"].isIntegral() || now >= claims["exp"].asInt64())
+		return false;
+	if (claims.isMember("nbf") && (!claims["nbf"].isIntegral() || now < claims["nbf"].asInt64()))
+		return false;
+	if (!claims["email"].isString() || claims["email"].asString().empty())
+		return false;
+	if (!pol.issuer.empty() &&
+	    (!claims["iss"].isString() || claims["iss"].asString() != pol.issuer))
+		return false;
+	if (!pol.audience.empty()) {
+		const auto &aud = claims["aud"];
+		if (aud.isString()) {
+			if (aud.asString() != pol.audience)
+				return false;
+		} else if (aud.isArray()) {
+			bool found = false;
+			for (const auto &e : aud)
+				found = found || (e.isString() && e.asString() == pol.audience);
+			if (!found)
+				return false;
+		} else {
+			return false;
+		}
+	}
+	return true;
+}
+
+}
--- a/tests/bearer.cpp
+++ b/tests/bearer.cpp
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 grommunio GmbH
+// This file is part of Gromox.
+#include <cstdio>
+#include <string>
+#include <cstdlib>
+#include <json/reader.h>
+#include <json/value.h>
+#include <gromox/bearer.hpp>
+
+using namespace gromox;
+
+static Json::Value J(const char *s)
+{
+	Json::Value v;
+	Json::Reader r;
+	if (!r.parse(s, v)) {
+		fprintf(stderr, "bad test json: %s\n", s);
+		exit(2);
+	}
+	return v;
+}
+
+static int fails;
+#define CHECK(name, expr) do { if (!(expr)) { ++fails; fprintf(stderr, "FAIL %s\n", name); } else { printf("ok   %s\n", name); } } while (0)
+
+int main()
+{
+	const time_t now = 1000000;
+	const auto H = J(R"({"alg":"RS256","typ":"JWT","kid":"k"})");
+	const char *good = R"({"exp":1000100,"iss":"https://kc/realms/r","aud":["account","ou-webmail"],"email":"bob@x.test"})";
+	bearer_policy none, both{"https://kc/realms/r", "ou-webmail"};
+
+	CHECK("legacy: no policy accepts a valid token", bearer_claims_valid(H, J(good), none, now));
+	CHECK("policy: iss+aud match (aud array)", bearer_claims_valid(H, J(good), both, now));
+	CHECK("policy: aud as plain string", bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://kc/realms/r","aud":"ou-webmail","email":"b@x"})"), both, now));
+	CHECK("reject: wrong audience (token of another client)", !bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://kc/realms/r","aud":"account","email":"b@x"})"), both, now));
+	CHECK("reject: missing aud when audience configured", !bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://kc/realms/r","email":"b@x"})"), both, now));
+	CHECK("reject: wrong issuer", !bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://evil/realms/r","aud":"ou-webmail","email":"b@x"})"), both, now));
+	CHECK("reject: missing iss when issuer configured", !bearer_claims_valid(H, J(R"({"exp":1000100,"aud":"ou-webmail","email":"b@x"})"), both, now));
+	CHECK("reject: audience substring is not a match", !bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://kc/realms/r","aud":"ou-webmail-evil","email":"b@x"})"), both, now));
+	CHECK("reject: aud array with non-string/other entries only", !bearer_claims_valid(H, J(R"({"exp":1000100,"iss":"https://kc/realms/r","aud":[1,"x"],"email":"b@x"})"), both, now));
+	for (const char *alg : {"none", "HS256", "RS512", "rs256", "ES256", ""})
+		CHECK(alg, !bearer_claims_valid(J((std::string(R"({"alg":")") + alg + R"("})").c_str()), J(good), none, now));
+	CHECK("reject: no alg", !bearer_claims_valid(J("{}"), J(good), none, now));
+	CHECK("reject: alg not a string", !bearer_claims_valid(J(R"({"alg":["RS256"]})"), J(good), none, now));
+	CHECK("reject: expired", !bearer_claims_valid(H, J(R"({"exp":999999,"email":"b@x"})"), none, now));
+	CHECK("reject: exp == now", !bearer_claims_valid(H, J(R"({"exp":1000000,"email":"b@x"})"), none, now));
+	CHECK("reject: exp missing", !bearer_claims_valid(H, J(R"({"email":"b@x"})"), none, now));
+	CHECK("reject: exp is a string", !bearer_claims_valid(H, J(R"({"exp":"9999999999","email":"b@x"})"), none, now));
+	CHECK("reject: nbf in the future", !bearer_claims_valid(H, J(R"({"exp":1000100,"nbf":1000050,"email":"b@x"})"), none, now));
+	CHECK("accept: nbf in the past", bearer_claims_valid(H, J(R"({"exp":1000100,"nbf":999000,"email":"b@x"})"), none, now));
+	CHECK("reject: email missing", !bearer_claims_valid(H, J(R"({"exp":1000100})"), none, now));
+	CHECK("reject: email empty", !bearer_claims_valid(H, J(R"({"exp":1000100,"email":""})"), none, now));
+	CHECK("reject: email not a string", !bearer_claims_valid(H, J(R"({"exp":1000100,"email":["a@x"]})"), none, now));
+	CHECK("reject: payload not an object", !bearer_claims_valid(H, J("[1]"), none, now));
+	return fails ? EXIT_FAILURE : EXIT_SUCCESS;
+}

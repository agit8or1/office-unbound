#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --sysconfdir=/etc --localstatedir=/var --disable-static

override_dh_auto_test:

override_dh_install:
	find debian/tmp -name '*.la' -delete
	# split: PHP extension -> ou-gromox-php-mapi, everything else -> ou-gromox
	mkdir -p debian/ou-gromox-php-mapi/usr/lib debian/ou-gromox
	mv debian/tmp/usr/lib/php debian/ou-gromox-php-mapi/usr/lib/
	cp -a debian/tmp/. debian/ou-gromox/
	# PHP ABI dependency of the extension
	echo "php:Depends=phpapi-$$(php-config --phpapi)" >> debian/ou-gromox-php-mapi.substvars

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_missing:

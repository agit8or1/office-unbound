# OpenCloud 9.1.0 environment rendered by the deployment engine (ics/ics/deploy/configure.py) into the files config volume as ou.env;
# read by the image entrypoint (KEY=VALUE, parsed, never evaluated). NO SECRETS here: the LDAP bind password and the initial admin password
# are podman secrets; opencloud.yaml (internal secrets) is generated by `opencloud init` on first start. Placeholders: @FILES_HOST@ @IDP_HOST@
# @OFFICE_HOST@ @REALM@ @LDAP_HOST@ @BASE_DN@. Derived from blueprints/lab/spike-identity-files/files/opencloud.env.tmpl (lab-verified).
OC_URL=https://@FILES_HOST@
OC_LOG_LEVEL=info
OC_INSECURE=false
PROXY_TLS=false
PROXY_HTTP_ADDR=127.0.0.1:9200
PROXY_ENABLE_BASIC_AUTH=false
PROXY_CSP_CONFIG_FILE_LOCATION=/var/lib/opencloud-config/csp.yaml
OC_EXCLUDE_RUN_SERVICES=idm,idp
OC_OIDC_ISSUER=https://@IDP_HOST@/realms/@REALM@
PROXY_OIDC_REWRITE_WELLKNOWN=true
IDP_DOMAIN=@IDP_HOST@
WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email
WEBFINGER_DESKTOP_OIDC_CLIENT_ID=OpenCloudDesktop
WEBFINGER_DESKTOP_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_ANDROID_OIDC_CLIENT_ID=OpenCloudAndroid
WEBFINGER_ANDROID_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_IOS_OIDC_CLIENT_ID=OpenCloudIOS
WEBFINGER_IOS_OIDC_CLIENT_SCOPES=openid profile email offline_access
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
SETTINGS_SETUP_DEFAULT_ASSIGNMENTS=false
# No administration inside OpenCloud (owner 2026-11-21: "opencloud shouldnt have admin settings"; people and roles are managed in the
# Office Unbound console). WEB_UI_CORE_APPS (OpenCloud >= 7.3.0, services/web/pkg/config/config.go) replaces the web core app list;
# this is the 9.1.0 default list minus "admin-settings", so nobody - not even the built-in ou-admin - gets the Admin settings app.
# "app-store" (OpenCloud's extension catalogue, fetched from the upstream project) is left out as well: nothing can be installed from it here,
# it only advertises the upstream product.
WEB_UI_CORE_APPS=files,search,text-editor,pdf-viewer,external,epub-reader,preview,rclone-crypt
OC_ADMIN_USER_ID=
PROXY_AUTOPROVISION_ACCOUNTS=false
PROXY_USER_OIDC_CLAIM=uuid
PROXY_USER_CS3_CLAIM=userid
GRAPH_USERNAME_MATCH=none
OC_LDAP_URI=ldaps://@LDAP_HOST@:636
OC_LDAP_INSECURE=false
OC_LDAP_CACERT=/opt/ou-tls/ca.crt
OC_LDAP_BIND_DN=cn=svc-bind,ou=system,@BASE_DN@
OC_LDAP_USER_BASE_DN=ou=people,@BASE_DN@
OC_LDAP_USER_FILTER=(!(pwdAccountLockedTime=*))
OC_LDAP_USER_OBJECTCLASS=inetOrgPerson
OC_LDAP_USER_SCHEMA_ID=entryUUID
OC_LDAP_USER_SCHEMA_ID_IS_OCTETSTRING=false
OC_LDAP_GROUP_BASE_DN=ou=groups,@BASE_DN@
OC_LDAP_GROUP_OBJECTCLASS=groupOfNames
OC_LDAP_GROUP_SCHEMA_ID=entryUUID
OC_LDAP_DISABLE_USER_MECHANISM=none
OC_LDAP_SERVER_WRITE_ENABLED=false
GRAPH_LDAP_SERVER_UUID=true
GRAPH_LDAP_REFINT_ENABLED=true
FRONTEND_READONLY_USER_ATTRIBUTES=user.onPremisesSamAccountName,user.displayName,user.mail,user.passwordProfile,user.accountEnabled,user.appRoleAssignments
STORAGE_USERS_DRIVER=posix
STORAGE_USERS_POSIX_WATCH_FS=true
# The office app as users see it ("Open in Documents", tab title, app switcher; owner 2026-11-21: rebrand all apps). One word (OpenCloud rule);
# it also names the editor's web route external-documents, which the portal's "New document" opens (portal services.editor_route asks
# /app/list, ICS brand.EDITOR_APP). COLLABORATION_APP_PRODUCT is the protocol flavour (Collabora/OnlyOffice/...), not shown to users.
COLLABORATION_APP_NAME=Documents
COLLABORATION_APP_DESCRIPTION=Open office documents with Office Unbound Docs
COLLABORATION_APP_PRODUCT=Collabora
COLLABORATION_APP_ADDR=https://@OFFICE_HOST@
COLLABORATION_APP_ICON=https://@FILES_HOST@/themes/ou/ou-mark.svg
COLLABORATION_WOPI_SRC=https://@FILES_HOST@
COLLABORATION_APP_INSECURE=false
COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false
# deployment CA + Let's Encrypt roots: OpenCloud and its collaboration service call auth/office/cloud through the gateway, which serves the
# public certificate after gateway.certificates.issue (with ca.crt alone the WOPI service answered 500 and documents stayed blank, 2026-11-21)
SSL_CERT_FILE=/opt/ou-tls/trust.crt
# Office Unbound skin (ics/ics/deploy/brand.py): theme "ou" from the config volume; web.yaml adds its stylesheet and the Dashboard link
WEB_ASSET_THEMES_PATH=/var/lib/opencloud-config/themes
WEB_UI_THEME_PATH=/themes/ou/theme.json
# Office Unbound, not the upstream product, wherever OpenCloud offers a switch (Web 8.2.2 options, services/web/pkg/config/options.go): no
# "Share improvement ideas" feedback link (an opencloud.eu survey) and no "Support OpenCloud" sponsor card; no update check against
# update.opencloud.eu (and no upstream "update available" notice); e-mail notifications use the Office Unbound layout (brand.py
# opencloud_mail_templates, under <config volume>/templates). The sidebar version line and upstream manual links are hidden by the skin.
WEB_OPTION_DISABLE_FEEDBACK_LINK=true
WEB_OPTION_DISABLE_SPONSOR_LINK=true
FRONTEND_CHECK_FOR_UPDATES=false
NOTIFICATIONS_EMAIL_TEMPLATE_PATH=/var/lib/opencloud-config

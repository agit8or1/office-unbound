{{/* Office Unbound e-mail layout: OpenCloud 9.1.0 services/notifications/pkg/email/templates/html/layout.html.tmpl (Apache-2.0, Copyright OpenCloud GmbH) with the product name in place of the OpenCloud logo images and footer, and the Office Unbound colours and type (blueprints/catalog/templates/brand/ou-brand.css). @PRODUCT@/@FOOTER@ are filled by ics/ics/deploy/brand.py. */}}
<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ .Subject }}</title>
<style>
:root { color-scheme: light dark; supported-color-schemes: light dark; }
@media (prefers-color-scheme: dark) {
    .oc-bg { background-color: #0f1926 !important; }
    .oc-card { background-color: #18263a !important; border-color: #26364c !important; }
    .oc-text { color: #d6dde6 !important; }
    .oc-muted { color: #9daabb !important; }
    .oc-link { color: #e8956c !important; }
    .oc-button { background-color: #e8956c !important; }
    .oc-button-text { color: #0f1926 !important; }
    .oc-box { background-color: #132034 !important; }
    .oc-dot { background-color: #e8956c !important; }
    .oc-line { background-color: #34475f !important; }
}
[data-ogsc] .oc-text { color: #d6dde6 !important; }
[data-ogsc] .oc-muted { color: #9daabb !important; }
[data-ogsc] .oc-link { color: #e8956c !important; }
[data-ogsc] .oc-button-text { color: #0f1926 !important; }
[data-ogsb] .oc-bg { background-color: #0f1926 !important; }
[data-ogsb] .oc-card { background-color: #18263a !important; }
[data-ogsb] .oc-button { background-color: #e8956c !important; }
[data-ogsb] .oc-box { background-color: #132034 !important; }
@media only screen and (max-width: 640px) {
    .oc-outer { padding: 16px 8px !important; }
    .oc-pad { padding-left: 24px !important; padding-right: 24px !important; }
}
</style>
</head>
<body class="oc-bg" style="margin: 0; padding: 0; background-color: #f7f5f0;">
<table role="presentation" class="oc-bg" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f7f5f0; font-family: 'IBM Plex Sans', 'Plex Sans', 'Segoe UI', -apple-system, Helvetica, Arial, sans-serif;">
    <tr>
        <td class="oc-outer" align="center" valign="top" style="padding: 40px 16px 32px;">
            <table role="presentation" class="oc-card" cellspacing="0" cellpadding="0" border="0" width="600" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e3dfd6; border-radius: 7px;">
                <tr>
                    <td class="oc-pad oc-text" style="padding: 32px 40px 0; font-size: 15px; line-height: 21px; font-weight: 700; color: #18212d;">@PRODUCT@</td>
                </tr>
                <tr>
                    <td class="oc-pad" style="padding: 32px 40px 0;">
                        <h1 class="oc-text" style="margin: 0; font-size: 21px; line-height: 28px; font-weight: 700; color: #18212d;">{{ .Subject }}</h1>
                    </td>
                </tr>
{{ block "content" . }}{{ end }}
            </table>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width: 100%; max-width: 600px;">
                <tr>
                    <td class="oc-pad oc-muted" style="padding: 24px 40px 0; font-size: 12.25px; line-height: 17.5px; color: #5c6470;">
                        @FOOTER@
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>

{
  "realm": "@REALM@",
  "displayName": "Office Unbound",
  "displayNameHtml": "Office Unbound",
  "enabled": true,
  "loginTheme": "ou",
  "accountTheme": "ou",
  "emailTheme": "ou",
  "sslRequired": "all",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "revokeRefreshToken": false,
  "organizationsEnabled": false,
  "attributes": {
    "frontendUrl": "https://@AUTH_HOST@"
  },
  "roles": {
    "realm": [
      {
        "name": "opencloudAdmin",
        "description": "OpenCloud admin (maps to OpenCloud role admin)"
      },
      {
        "name": "opencloudSpaceAdmin",
        "description": "OpenCloud space admin"
      },
      {
        "name": "opencloudUser",
        "description": "OpenCloud user"
      },
      {
        "name": "opencloudGuest",
        "description": "OpenCloud guest (user-light)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "web",
      "description": "OpenCloud Web (public, PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [

[Unit]
Description=Office Unbound ICS guest-bootstrap listener (own port, own pinned TLS certificate, only the callback route)
Documentation=file:///opt/office-unbound/ics/README.md
ConditionPathExists=/etc/office-unbound/callback.env
After=network-online.target postgresql.service ics-migrate.service
Wants=network-online.target
Requires=ics-migrate.service postgresql.service

[Service]
Type=simple
User=ics
Group=ics
WorkingDirectory=/opt/office-unbound/ics
# ics_app credentials only. The owner (migration) URL lives in ics-migrate.env (root 0600) and is never loaded here.
EnvironmentFile=/etc/office-unbound/ics.env
# listen address + TLS paths (no secrets); written by bootstrap.sh --callback-listen. The unit is a no-op until this file exists.
EnvironmentFile=/etc/office-unbound/callback.env
# the TLS key stays root 0600: systemd hands the service a private copy
LoadCredential=callback.key:/etc/office-unbound/callback-tls/callback.key
LoadCredential=callback.crt:/etc/office-unbound/callback-tls/callback.crt
Environment=ICS_GUEST_CALLBACK_TLS_KEY=%d/callback.key ICS_GUEST_CALLBACK_TLS_CERT=%d/callback.crt
ExecStart=/opt/office-unbound/ics/.venv/bin/python -m ics.serve_callback
TasksMax=64
LimitNOFILE=1024
Restart=on-failure
RestartSec=3
UMask=0077

# --- hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
ReadOnlyPaths=/opt/office-unbound /etc/office-unbound
InaccessiblePaths=-/etc/office-unbound/tls -/etc/office-unbound/callback-tls -/etc/office-unbound/ics-migrate.env -/etc/office-unbound/ics-test.env -/etc/office-unbound/lab

[Install]
WantedBy=multi-user.target

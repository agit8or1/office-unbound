[Unit]
Description=Office Unbound telephony runbook (pbx-issue) for %i

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/ou-pbx-user issue %i
RuntimeDirectory=ou-rb-secret
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true

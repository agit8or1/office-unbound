#!/usr/bin/python3
"""Root helper for the ou-agent telephony runbooks on the PBX node. Started ONLY by the fixed template units ou-rb-pbx-<verb>@<instance>.service.
usage: ou-pbx-user sync|kick|state <uid>      |      ou-pbx-user issue <uid>.<device>      (everything validated again here; no env, no stdin)
The real work is done by /usr/local/bin/ou-pbx (blueprints/telephony/pbx/ou_pbx.py) as the unprivileged user ou-pbx; this helper only
validates, drops privileges, and writes the result file the agent returns to the ICS:
  sync   -> ou-pbx report --user U   (LDAP -> pjsip/dialplan/voicemail config, reload only if changed; this user's state)
  kick   -> ou-pbx kick --user U     (sync from the directory, delete registrations, hang up live calls)
  state  -> ou-pbx state --user U    (read-only)
  issue  -> ou-pbx issue --user U --device D   (credential returned ONCE; created 0600 (O_EXCL|O_NOFOLLOW, fchown to ou-agent) in /run/ou-rb-secret (a root-owned 1770 directory, group ou-agent) for the agent only, never to /run/ou-rb)
"""
import json, os, pwd, re, shutil, stat, subprocess, sys, time

UID_RE = re.compile(r"^[a-z][a-z0-9._-]{1,31}$")
DEVICES = ("web", "native", "desk")
OUT, SECRET = "/run/ou-rb", "/run/ou-rb-secret"
PBX = "/usr/local/bin/ou-pbx"


def run(args):
    cmd = ["/usr/bin/setpriv", "--reuid=ou-pbx", "--regid=ou-pbx", "--init-groups", PBX, *args]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=50, stdin=subprocess.DEVNULL, env={"PATH": "/usr/bin:/bin", "LANG": "C"})
    if r.returncode != 0:
        sys.stderr.write(r.stderr[-300:])
        sys.exit(1)
    return json.loads(r.stdout.strip().splitlines()[-1])


SECRET_NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,120}$")


def secret_dir_fd(path, owner_uid, agent_gid):
    """Review 5 H3: the secret directory is OWNED BY ROOT (mode 1770, group ou-agent: the agent may create nothing we trust and may unlink only its own
    files). A directory that is not exactly that (agent-owned from an older install, a symlink, a plain file) is removed and recreated; the directory
    is then used through a file descriptor only, so no path component is looked up twice."""
    try:
        st = os.lstat(path)
        ok = stat.S_ISDIR(st.st_mode) and st.st_uid == owner_uid
    except FileNotFoundError:
        ok = None
    if ok is False:
        if stat.S_ISDIR(st.st_mode):
            shutil.rmtree(path)
        else:
            os.unlink(path)
    if not ok:
        os.mkdir(path, 0o700)
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if st.st_uid != owner_uid:
        os.close(fd)
        sys.exit("secret directory is not owned by the helper's identity")
    os.fchown(fd, owner_uid, agent_gid)
    os.fchmod(fd, 0o1770)
    return fd


def write_secret(dirpath, name, payload, owner_uid, agent_uid, agent_gid):
    """create <dirpath>/<name> with O_CREAT|O_EXCL|O_NOFOLLOW inside the root-owned directory, fchown the FD (never a path) to the agent"""
    if not SECRET_NAME_RE.match(name):
        sys.exit(2)
    dfd = secret_dir_fd(dirpath, owner_uid, agent_gid)
    try:
        for f in os.listdir(dfd):                   # leftovers of a crashed run never live longer than the next issue; entries are never followed
            try:
                st = os.stat(f, dir_fd=dfd, follow_symlinks=False)
                if f == name or (time.time() - st.st_mtime > 60 and not stat.S_ISDIR(st.st_mode)):
                    os.unlink(f, dir_fd=dfd)
            except OSError:
                pass
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dfd)   # a racing re-planted entry => EEXIST: fail closed
        try:
            os.fchown(fd, agent_uid, agent_gid)
            os.fchmod(fd, 0o600)
            os.write(fd, payload)
        finally:
            os.close(fd)
    finally:
        os.close(dfd)


def main():
    verb, arg = sys.argv[1], sys.argv[2]
    if verb == "issue":
        uid, _, dev = arg.rpartition(".")
        if dev not in DEVICES or not UID_RE.match(uid):
            sys.exit(2)
        data = run(["issue", "--user", uid, "--device", dev])
        data.update({"uid": uid, "device": dev, "ts": int(time.time())})
        ag = pwd.getpwnam("ou-agent")
        write_secret(SECRET, "pbx-issue-%s.%s.json" % (uid, dev), json.dumps(data).encode(), 0, ag.pw_uid, ag.pw_gid)
        return
    uid = arg
    if verb not in ("sync", "kick", "state") or not UID_RE.match(uid):
        sys.exit(2)
    data = run([{"sync": "report", "kick": "kick", "state": "state"}[verb], "--user", uid])
    data.update({"uid": uid, "ts": int(time.time())})
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, "pbx-%s-%s.json" % (verb, uid))
    with open(path + ".tmp", "w") as f:
        json.dump(data, f)
    os.chmod(path + ".tmp", 0o644)
    os.replace(path + ".tmp", path)


if __name__ == "__main__":
    main()

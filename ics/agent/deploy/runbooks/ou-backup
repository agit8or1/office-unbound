#!/usr/bin/python3
"""ou-backup: the fixed backup runner behind the node-agent runbooks backup.run / backup.verify / backup.prune (ADR-0010).

Two entry points, both root-only:
  ou-backup <rid>                      started by ou-rb-backup@<rid>.service; reads the agent's spool file {action, params}, RE-VALIDATES it
                                       (the agent already did; this helper never trusts the spool), writes /run/ou-rb-backup/<rid>.json
  ou-backup --direct <cmd> <tier> ...  operator/provisioning use on the node console: init | provision | recovery-key | run | check | restore | prune

Nothing here accepts a command line, a path or a repository from the caller. Everything that could differ per node (which machine is the source,
which repository, which credentials, which scratch machine, which scripts) comes from the root-owned /etc/ou-backup/<tier>.json. Secrets: the
repository password and the REST credentials live in root-only files; they reach restic through its environment / a password file, never argv,
never a log line (all captured output is scrubbed of the known secrets before it leaves this process).
Hooks = the existing tier backup scripts (online-consistent, read-only against the source): files-backup.sh, id-backup.sh, gw-backup.sh, ics-backup.sh.
"""
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import time

CONFIG_DIR = "/etc/ou-backup"
ROOT_UID = 0   # tests substitute the invoking uid
SPOOL_DIR = "/run/ou-agent-spool"
RUN_DIR = "/run/ou-rb-backup"
TIERS = ("files", "identity", "groupware", "ics")
SNAP_RE = re.compile(r"^[0-9a-f]{8,64}$")
RID_RE = re.compile(r"^r[0-9a-f]{16}$")
PROFILE_RE = re.compile(r"^c-[0-9a-f]{32}$")
ENV = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8"}
BACKUP_SCRIPT = {"files": "files-backup.sh", "identity": "id-backup.sh", "groupware": "gw-backup.sh", "ics": "ics-backup.sh"}
RESTORE_SCRIPT = {"files": ["files-restore.sh"], "identity": ["id-restore.sh"], "groupware": ["gw-restore.sh", "restore"], "ics": ["ics-restore.sh"]}
BACKUP_ENV_KEYS = ("OU_ICS_PREFIX", "OU_ICS_DB", "OU_ICS_ROLES", "OU_ICS_DB_OWNER")   # the only environment a tier config may hand to the backup hook
SERVICES = {"files": ["opencloud", "opencloud-collaboration", "nginx"], "identity": ["slapd", "postgresql", "keycloak"],
            "groupware": ["mariadb", "gromox-http", "gromox-imap", "nginx", "postfix"]}
ARCHIVE = {"files": "files.tar", "identity": "identity.tar", "groupware": "groupware.tar", "ics": "ics-backup.tar"}


class Fail(Exception):
    """Message is safe to return to the ICS (no secrets)."""


def now() -> float:
    return time.time()


def _claims(profile: str | None) -> list[tuple[str, str, str]]:
    """(profile, role, machine) for every machine named in any tier config of any profile on this node: source ('machine') and scratch."""
    out = []
    for d, prof in [(CONFIG_DIR, "")] + [(os.path.join(CONFIG_DIR, e), e) for e in sorted(os.listdir(CONFIG_DIR)) if PROFILE_RE.match(e)]:
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if f.endswith(".json"):
                try:
                    c = json.load(open(os.path.join(d, f)))
                except (OSError, ValueError):
                    continue
                for role in ("machine", "scratch"):
                    if c.get(role):
                        out.append((prof, role, c[role]))
    return out


def load_cfg(tier: str, customer: str | None = None) -> dict:
    """customer = per-customer profile (c-<32 hex>): config, credentials, staging and repository namespace of that customer only. A profile config
    must prove it is self-contained: its REST user, repository path, credentials dir and staging dir all carry the profile, and none of its machines
    (source or scratch restore target) is claimed by any other profile's or the legacy config."""
    if tier not in TIERS:
        raise Fail("unknown tier")
    if customer is not None and not PROFILE_RE.match(customer):
        raise Fail("bad customer profile")
    p = os.path.join(CONFIG_DIR, customer, tier + ".json") if customer else os.path.join(CONFIG_DIR, tier + ".json")
    try:
        st = os.stat(p)
    except OSError:
        raise Fail(f"tier {tier} is not configured on this node") from None
    if st.st_uid != ROOT_UID or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise Fail("tier config must be root-owned and not group/world-writable")
    cfg = json.load(open(p))
    for k in ("machine", "repo_url", "cacert", "creds_dir", "scripts_dir", "stage_dir", "restic", "restic_sha256"):
        if k not in cfg:
            raise Fail(f"tier config lacks {k}")
    if customer:
        if cfg.get("customer") != customer:
            raise Fail("tier config does not belong to this customer profile")
        for k in ("repo_url", "maint_repo_url"):
            if cfg.get(k) and not re.match(r"^https://[^/]+/" + re.escape(customer) + r"(/|$)", cfg[k]):
                raise Fail(f"{k} is outside the customer's repository namespace")
        if os.path.realpath(cfg["creds_dir"]) != os.path.realpath(os.path.join(CONFIG_DIR, customer, "creds", tier)):
            raise Fail("creds_dir is not the customer's own credentials directory")
        if os.path.basename(cfg["stage_dir"].rstrip("/")) != customer:
            raise Fail("stage_dir is not the customer's own staging directory")
        mine = {m for m in (cfg.get("machine"), cfg.get("scratch")) if m}
        for prof, role, m in _claims(customer):
            if prof != customer and m in mine:
                raise Fail(f"machine {m} is also configured for another customer profile or the legacy config (isolation)")
        try:
            if read_secret(cfg, "rest-user") != customer:
                raise Fail("the REST user of this profile must be the profile name (rest-server --private-repos)")
        except Fail as e:
            if "not provisioned" not in str(e):
                raise
    return cfg


def secret_file(cfg: dict, name: str) -> str:
    p = os.path.join(cfg["creds_dir"], name)
    try:
        st = os.stat(p)
    except OSError:
        raise Fail(f"credential {name} is not provisioned on this node") from None
    if st.st_uid != ROOT_UID or st.st_mode & 0o077:
        raise Fail(f"credential file {name} must be root-owned 0600")
    return p


def read_secret(cfg: dict, name: str) -> str:
    return open(secret_file(cfg, name)).read().strip()


class Scrub:
    def __init__(self, cfg: dict):
        self.words = []
        for n in ("repo-password", "rest-password", "maint-password"):
            try:
                v = read_secret(cfg, n)
                if len(v) >= 6:
                    self.words.append(v)
            except Fail:
                pass

    def __call__(self, s: str, limit: int = 600) -> str:
        for w in self.words:
            s = s.replace(w, "[secret]")
        return re.sub(r"[^\x20-\x7e\n]", "?", s)[-limit:]


def restic(cfg: dict, args: list[str], *, maint: bool = False, timeout: int = 900, extra_env: dict | None = None) -> subprocess.CompletedProcess:
    exe = cfg["restic"]
    got = hashlib.sha256(open(exe, "rb").read()).hexdigest()
    if got != cfg["restic_sha256"]:
        raise Fail("restic binary does not match the pinned sha256")
    url = cfg.get("maint_repo_url") if maint else cfg["repo_url"]
    if not url:
        raise Fail("no maintenance repository endpoint configured on this node")
    user, pw = ("maint-user", "maint-password") if maint else ("rest-user", "rest-password")
    env = dict(ENV, RESTIC_REPOSITORY="rest:" + url.rstrip("/") + "/", RESTIC_PASSWORD_FILE=secret_file(cfg, "repo-password"),
               RESTIC_CACERT=cfg["cacert"], RESTIC_REST_USERNAME=read_secret(cfg, user), RESTIC_REST_PASSWORD=read_secret(cfg, pw),
               RESTIC_CACHE_DIR=os.path.join(cfg["stage_dir"], ".restic-cache"), HOME="/root", **(extra_env or {}))
    try:
        return subprocess.run([exe, *args], env=env, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Fail("restic timed out") from None


def j(out: str):
    return json.loads(out)


def jlines(out: str) -> list:
    res = []
    for line in out.splitlines():
        try:
            res.append(json.loads(line))
        except ValueError:
            pass
    return res


def repo_stats(cfg: dict, scrub: Scrub) -> dict:
    r = restic(cfg, ["stats", "--mode", "raw-data", "--json"], timeout=120)
    if r.returncode != 0:
        return {}
    d = j(r.stdout)
    return {"repo_bytes": d.get("total_size"), "repo_blobs": d.get("total_blob_count")}


def repo_id(cfg: dict) -> str | None:
    r = restic(cfg, ["cat", "config", "--json"], timeout=60)
    return j(r.stdout).get("id") if r.returncode == 0 else None


def in_machine(machine: str, argv: list[str], stdin_path: str | None = None, timeout: int = 300) -> subprocess.CompletedProcess:
    cmd = ["/usr/bin/systemd-run", "-M", machine, "--wait", "-q", "-P", "--pipe", *argv]
    with open(stdin_path, "rb") if stdin_path else open(os.devnull, "rb") as fin:
        return subprocess.run(cmd, env=ENV, stdin=fin, capture_output=True, text=True, timeout=timeout)


def canary(cfg: dict, machine: str, tier: str) -> dict | None:
    if tier == "ics" or not cfg.get("canary"):
        return None
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ou-backup-canary.py")
    if not os.path.exists(script):
        script = "/usr/local/sbin/ou-backup-canary.py"
    r = in_machine(machine, ["/usr/bin/python3", "-", tier, json.dumps(cfg["canary"])], stdin_path=script, timeout=120)
    if r.returncode != 0:
        raise Fail("canary could not be read from the machine: " + r.stderr.strip()[-200:])
    res = json.loads(r.stdout)
    return res if any(res.values()) else None   # an empty canary (nothing found) is "no canary": it must never make a restore look verified


# ---- operations -----------------------------------------------------------------------------------------------------------------------
def op_run(tier: str, customer: str | None = None) -> dict:
    cfg = load_cfg(tier, customer)
    scrub = Scrub(cfg)
    t0 = now()
    stage_root = os.path.join(cfg["stage_dir"], tier)
    shutil.rmtree(stage_root, ignore_errors=True)
    os.makedirs(stage_root, mode=0o700)
    os.chmod(cfg["stage_dir"], 0o700)
    try:
        canary_error = None
        try:
            expected = canary(cfg, cfg["machine"], tier)
        except Fail as e:   # the backup still runs (data protection first); the restore verification will fail loudly without a canary
            expected, canary_error = None, str(e)[:200]
        t1 = now()
        benv = {k: v for k, v in (cfg.get("backup_env") or {}).items() if k in BACKUP_ENV_KEYS and isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9_|/.-]{0,200}", v)}
        env = dict(ENV, OU_ONLINE="1", **benv)
        script = os.path.join(cfg["scripts_dir"], BACKUP_SCRIPT[tier])
        r = subprocess.run([script, cfg["machine"], os.path.join(stage_root, "inbox")] if tier != "ics" else [script, os.path.join(stage_root, "inbox")],
                           env=env, capture_output=True, text=True, timeout=cfg.get("backup_timeout", 1800), stdin=subprocess.DEVNULL)
        if r.returncode != 0:
            raise Fail(f"{BACKUP_SCRIPT[tier]} failed (rc={r.returncode}): " + scrub(r.stderr))
        dest = r.stdout.strip().splitlines()[-1]
        if not os.path.realpath(dest).startswith(os.path.realpath(os.path.join(stage_root, "inbox")) + "/"):
            raise Fail("backup script returned a path outside the staging area")
        t2 = now()
        cur = os.path.join(stage_root, "current")
        os.rename(dest, cur)
        if expected is not None:
            with open(os.path.join(cur, "MANIFEST"), "a") as f:
                f.write("canary_json=" + json.dumps(expected, sort_keys=True) + "\n")
        archive = os.path.join(cur, ARCHIVE[tier])
        archive_bytes = os.stat(archive).st_size if os.path.exists(archive) else None
        rid = secrets.token_hex(4)
        b = restic(cfg, ["backup", "--json", "--host", cfg["machine"], "--tag", f"tier:{tier}", "--tag", f"run:{rid}", "--one-file-system", cur],
                   timeout=cfg.get("restic_timeout", 1800))
        if b.returncode != 0:
            raise Fail("restic backup failed: " + scrub(b.stderr))
        summ = next((m for m in jlines(b.stdout) if m.get("message_type") == "summary"), None)
        if not summ:
            raise Fail("restic backup returned no summary")
        t3 = now()
        sn = restic(cfg, ["snapshots", "--json", "--tag", f"run:{rid}", "--host", cfg["machine"]], timeout=120)
        snaps = j(sn.stdout) if sn.returncode == 0 else []
        confirmed = any(s["id"] == summ["snapshot_id"] for s in snaps)
        allsn = restic(cfg, ["snapshots", "--json", "--tag", f"tier:{tier}"], timeout=120)
        total = len(j(allsn.stdout)) if allsn.returncode == 0 else None
        res = {"tier": tier, "snapshot": summ["snapshot_id"], "snapshot_short": summ["snapshot_id"][:8], "run_tag": rid,
               "bytes_added": summ.get("data_added"), "bytes_added_packed": summ.get("data_added_packed"),
               "bytes_processed": summ.get("total_bytes_processed"), "files_new": summ.get("files_new"),
               "files_changed": summ.get("files_changed"), "files_unmodified": summ.get("files_unmodified"),
               "archive_bytes": archive_bytes, "repo_confirmed": confirmed, "snapshots_total": total, "repo_id": repo_id(cfg),
               "canary_recorded": expected is not None, "canary_error": canary_error, "consistency": "online",
               "seconds": {"canary": round(t1 - t0, 1), "source_export": round(t2 - t1, 1), "restic": round(t3 - t2, 1), "total": round(now() - t0, 1)},
               **repo_stats(cfg, scrub)}
        if not confirmed:
            raise Fail("snapshot was written but is not listed in the repository")
        return res
    finally:
        shutil.rmtree(stage_root, ignore_errors=True)


def op_check(tier: str, percent: int, customer: str | None = None) -> dict:
    cfg = load_cfg(tier, customer)
    scrub = Scrub(cfg)
    t0 = now()
    r = restic(cfg, ["check", f"--read-data-subset={percent}%"], timeout=cfg.get("check_timeout", 3000))
    res = {"tier": tier, "level": "check", "passed": r.returncode == 0, "read_data_percent": percent, "seconds": round(now() - t0, 1),
           "output_tail": scrub(r.stdout + r.stderr, 400), **repo_stats(cfg, scrub), "repo_id": repo_id(cfg)}
    return res


def wait_ready(machine: str, timeout: int = 90) -> None:
    t = now()
    while now() - t < timeout:
        r = subprocess.run(["/usr/bin/systemd-run", "-M", machine, "--wait", "-q", "-P", "/bin/true"], env=ENV, capture_output=True, timeout=30)
        if r.returncode == 0:
            return
        time.sleep(1)
    raise Fail(f"scratch machine {machine} did not come up")


def op_restore(tier: str, snapshot: str | None, customer: str | None = None) -> dict:
    cfg = load_cfg(tier, customer)
    if tier == "ics":
        return op_restore_ics(cfg, snapshot)
    if tier not in RESTORE_SCRIPT or not cfg.get("scratch"):
        raise Fail(f"restore verification is not configured for tier {tier}")
    scrub = Scrub(cfg)
    scratch = cfg["scratch"]
    if scratch == cfg["machine"]:
        raise Fail("scratch machine must differ from the source machine")
    target = os.path.join(cfg["stage_dir"], f"restore-{tier}")
    shutil.rmtree(target, ignore_errors=True)
    os.makedirs(target, mode=0o700)
    t0 = now()
    powered = False
    try:
        if snapshot:
            snap = snapshot
        else:   # resolve "latest" now so the result names the snapshot that was really restored
            ls = restic(cfg, ["snapshots", "latest", "--json", "--host", cfg["machine"], "--tag", f"tier:{tier}"], timeout=120)
            found = j(ls.stdout) if ls.returncode == 0 else []
            if not found:
                raise Fail("repository holds no snapshot for this tier")
            snap = found[-1]["id"]
        r = restic(cfg, ["restore", snap, "--target", target, "--host", cfg["machine"], "--tag", f"tier:{tier}", "--json"], timeout=cfg.get("restic_timeout", 1800))
        if r.returncode != 0:
            raise Fail("restic restore failed: " + scrub(r.stderr))
        done = next((m for m in jlines(r.stdout) if m.get("message_type") == "summary"), {})
        t1 = now()
        d = target + os.path.join(cfg["stage_dir"], tier, "current")
        mf = {k: v for k, _, v in (l.partition("=") for l in open(os.path.join(d, "MANIFEST")).read().splitlines())}
        expected = json.loads(mf["canary_json"]) if "canary_json" in mf else None
        sha = hashlib.sha256()
        with open(os.path.join(d, ARCHIVE[tier]), "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                sha.update(chunk)
        if sha.hexdigest() != mf.get("archive_sha256"):
            raise Fail("restored archive does not match the MANIFEST checksum (corrupt backup)")
        subprocess.run(["/usr/bin/machinectl", "start", scratch], env=ENV, capture_output=True, timeout=60)
        powered = True
        wait_ready(scratch)
        t2 = now()   # scratch machine is up (a real DR would provision it; reported separately)
        script = os.path.join(cfg["scripts_dir"], RESTORE_SCRIPT[tier][0])
        renv = {k: v for k, v in (cfg.get("restore_env") or {}).items() if k in ("OU_REALM", "OU_DOMAIN") and isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9.-]{1,100}", v)}
        rr = subprocess.run([script, *RESTORE_SCRIPT[tier][1:], d, scratch], env=dict(ENV, OU_INTO_EXISTING="1", **renv), capture_output=True, text=True,
                            timeout=cfg.get("restore_timeout", 2400), stdin=subprocess.DEVNULL)
        if rr.returncode != 0:
            raise Fail(f"{RESTORE_SCRIPT[tier][0]} failed (rc={rr.returncode}): " + scrub(rr.stderr))
        t3 = now()
        observed = canary(cfg, scratch, tier)
        svcs = cfg.get("services") or SERVICES[tier]
        act = in_machine(scratch, ["/bin/bash", "-c", "for s in " + " ".join(svcs) + "; do printf '%s=%s\\n' $s $(systemctl is-active $s); done"], timeout=60)
        inactive = [l.split("=")[0] for l in act.stdout.split() if not l.endswith("=active")]
        t4 = now()
        match = expected is not None and observed == expected and not inactive
        problems = [f"service {n} is not active on the restored machine" for n in inactive]
        if expected is None:
            problems.append("no canary was recorded at backup time")
        elif not match:
            for k in sorted(set(expected) | set(observed or {})):
                if expected.get(k) != (observed or {}).get(k):
                    problems.append(f"canary {k} differs")
        return {"tier": tier, "level": "restore", "snapshot": snap, "services_checked": svcs, "match": match, "problems": problems,
                "canary_expected": expected, "canary_observed": observed, "scratch": scratch,
                "restic_restore_bytes": done.get("bytes_restored"),
                "seconds": {"restic_restore": round(t1 - t0, 1), "scratch_poweron": round(t2 - t1, 1), "data_restore": round(t3 - t2, 1),
                            "canary": round(t4 - t3, 1)},
                "rto_seconds": round((t1 - t0) + (t3 - t2) + (t4 - t3), 1),
                "rto_seconds_incl_poweron": round(t4 - t0, 1)}
    finally:
        shutil.rmtree(target, ignore_errors=True)
        if powered:
            subprocess.run(["/usr/bin/machinectl", "poweroff", scratch], env=ENV, capture_output=True, timeout=60)



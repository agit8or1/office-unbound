def op_restore_ics(cfg: dict, snapshot: str | None) -> dict:
    """Passive-restore flow of docs/runbooks/ics-recovery.md into a scratch machine, then the verification of that runbook: audit chain verifies and
    contains the backup-time head event with the same hash, schema at the backed-up head, worker/monitor OFF (passive), and an operator can log in
    (password hash + vault key decrypting the TOTP secret + audit key appending). The restored controller can reach no managed node: it is passive."""
    scrub = Scrub(cfg)
    scratch = cfg.get("scratch")
    if not scratch or scratch == cfg["machine"]:
        raise Fail("ics restore verification needs a scratch machine that differs from the source")
    canary_file = cfg.get("login_canary_file")
    if not canary_file:
        raise Fail("login_canary_file is not configured (a low-privilege operator account of the controller)")
    if os.path.dirname(canary_file) != cfg["creds_dir"]:
        raise Fail("login_canary_file must live in the tier's creds dir")
    cj = json.loads(read_secret(cfg, os.path.basename(canary_file)))
    if not {"username", "password", "totp_secret"} <= set(cj):
        raise Fail("login canary file must be in the creds dir and hold username, password, totp_secret")
    tier = "ics"
    target = os.path.join(cfg["stage_dir"], "restore-ics")
    shutil.rmtree(target, ignore_errors=True)
    os.makedirs(target, mode=0o700)
    t0 = now()
    powered = False
    try:
        if snapshot:
            snap = snapshot
        else:
            ls = restic(cfg, ["snapshots", "latest", "--json", "--host", cfg["machine"], "--tag", "tier:ics"], timeout=120)
            found = j(ls.stdout) if ls.returncode == 0 else []
            if not found:
                raise Fail("repository holds no snapshot for this tier")
            snap = found[-1]["id"]
        r = restic(cfg, ["restore", snap, "--target", target, "--host", cfg["machine"], "--tag", "tier:ics", "--json"], timeout=cfg.get("restic_timeout", 1800))
        if r.returncode != 0:
            raise Fail("restic restore failed: " + scrub(r.stderr))
        t1 = now()
        d = target + os.path.join(cfg["stage_dir"], "ics", "current")
        mf = {k: v for k, _, v in (l.partition("=") for l in open(os.path.join(d, "MANIFEST")).read().splitlines())}
        sha = hashlib.sha256()
        with open(os.path.join(d, ARCHIVE["ics"]), "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                sha.update(chunk)
        if sha.hexdigest() != mf.get("archive_sha256"):
            raise Fail("restored archive does not match the MANIFEST checksum (corrupt backup)")
        subprocess.run(["/usr/bin/machinectl", "start", scratch], env=ENV, capture_output=True, timeout=60)
        powered = True
        wait_ready(scratch)
        t2 = now()
        script = os.path.join(cfg["scripts_dir"], RESTORE_SCRIPT["ics"][0])
        rr = subprocess.run([script, d, scratch], env=dict(ENV, OU_INTO_EXISTING="1"), capture_output=True, text=True, timeout=cfg.get("restore_timeout", 2400), stdin=subprocess.DEVNULL)
        if rr.returncode != 0:
            raise Fail(f"ics-restore.sh failed (rc={rr.returncode}): " + scrub(rr.stderr))
        t3 = now()
        db = mf.get("db_name", "ics")
        if not re.fullmatch(r"[a-z][a-z0-9_]{0,40}", db) or not re.fullmatch(r"[0-9]{1,12}", mf.get("audit_head_seq", "x")):
            raise Fail("MANIFEST has malformed database name / audit head")
        problems = []
        ch = in_machine(scratch, ["/bin/bash", "-c", "set -a; . /etc/office-unbound/ics.env; set +a; cd /opt/office-unbound/ics && /usr/sbin/runuser -u ics -- "
                                  "/opt/office-unbound/ics/.venv/bin/python -m ics.cli verify-chain"], timeout=300)
        chain = {}
        try:
            import ast
            chain = ast.literal_eval(ch.stdout.strip().splitlines()[-1]) if ch.stdout.strip() else {}
        except (ValueError, SyntaxError):
            pass
        if ch.returncode != 0 or not chain.get("ok"):
            problems.append("audit chain does not verify on the restored controller")
        head = in_machine(scratch, ["/usr/sbin/runuser", "-u", "postgres", "--", "psql", "-d", db, "-Atc", f"select hash from audit_events where seq = {mf['audit_head_seq']}"], timeout=60).stdout.strip()
        if head != mf.get("audit_head_hash"):
            problems.append("restored audit chain lacks the backup-time head event (or its hash differs)")
        ah = in_machine(scratch, ["/usr/sbin/runuser", "-u", "postgres", "--", "psql", "-d", db, "-Atc", "select version_num from alembic_version"], timeout=60).stdout.strip()
        if ah != mf.get("alembic_head"):
            problems.append("restored schema is not at the backed-up alembic head")
        env_txt = in_machine(scratch, ["/bin/cat", "/etc/office-unbound/ics.env"], timeout=30).stdout
        passive = "ICS_WORKER_ENABLED=false" in env_txt and "ICS_MONITOR_ENABLED=false" in env_txt
        if not passive:
            problems.append("restored controller is not passive (worker/monitor not disabled)")
        croot = os.stat(os.path.join("/var/lib/machines", scratch, "root")).st_uid   # PrivateUsers=pick uid shift
        fd = os.open(os.path.join("/var/lib/machines", scratch, "root", "ics-login-canary.json"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.fchown(fd, croot, croot)
        with os.fdopen(fd, "w") as f:
            json.dump(cj, f)
        try:
            lg = in_machine(scratch, ["/opt/office-unbound/ics/.venv/bin/python", "-c", ICS_LOGIN_PY], timeout=240)
        finally:
            try:
                os.unlink(os.path.join("/var/lib/machines", scratch, "root", "ics-login-canary.json"))
            except OSError:
                pass
        try:
            lgj = json.loads(lg.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            lgj = {}
        login_ok = (lgj.get("login") or {}).get("status") == 200 and (lgj.get("login") or {}).get("csrf") is True
        if not login_ok:
            problems.append("operator login on the restored controller failed: " + scrub(json.dumps(lgj.get("login")) + lg.stderr[-200:], 300))
        if lgj.get("ready") is True:
            problems.append("restored controller reports ready: a passive controller must not (worker is off)")
        t4 = now()
        expected = {"audit_head_seq": mf.get("audit_head_seq"), "audit_head_hash": mf.get("audit_head_hash"), "alembic_head": mf.get("alembic_head")}
        observed = {"audit_head_seq": mf.get("audit_head_seq") if head == mf.get("audit_head_hash") else None, "audit_head_hash": head or None, "alembic_head": ah or None}
        return {"tier": "ics", "level": "restore", "snapshot": snap, "services_checked": ["ics"], "match": not problems, "problems": problems,
                "canary_expected": expected, "canary_observed": observed, "scratch": scratch, "chain_checked": chain.get("checked"), "passive": passive,
                "operator_login": login_ok, "seconds": {"restic_restore": round(t1 - t0, 1), "scratch_poweron": round(t2 - t1, 1), "data_restore": round(t3 - t2, 1),
                                                         "canary": round(t4 - t3, 1)},
                "rto_seconds": round((t1 - t0) + (t3 - t2) + (t4 - t3), 1), "rto_seconds_incl_poweron": round(t4 - t0, 1)}
    finally:
        shutil.rmtree(target, ignore_errors=True)
        if powered:
            subprocess.run(["/usr/bin/machinectl", "poweroff", scratch], env=ENV, capture_output=True, timeout=60)


def op_prune(tier: str, keep: dict, customer: str | None = None) -> dict:
    cfg = load_cfg(tier, customer)
    scrub = Scrub(cfg)
    t0 = now()
    args = ["forget", "--json", "--prune", "--group-by", "host,tags", "--tag", f"tier:{tier}"]
    for k in ("last", "daily", "weekly", "monthly"):
        if keep[k]:
            args += [f"--keep-{k}", str(keep[k])]
    r = restic(cfg, args, maint=True, timeout=cfg.get("prune_timeout", 3000))
    if r.returncode != 0:
        raise Fail("restic forget/prune failed: " + scrub(r.stderr))
    groups = []
    for line in r.stdout.splitlines():
        try:
            groups = json.loads(line) if line.startswith("[") else groups
        except ValueError:
            pass
    kept = sum(len(g.get("keep") or []) for g in groups)
    removed = sum(len(g.get("remove") or []) for g in groups)
    return {"tier": tier, "kept": kept, "removed": removed, "seconds": round(now() - t0, 1), **repo_stats(cfg, scrub)}


# ---- provisioning (console, direct) ---------------------------------------------------------------------------------------------------
def op_provision(tier: str, customer: str | None = None) -> dict:
    """Reads one JSON object from stdin: {repo_password, rest_user, rest_password[, maint_user, maint_password]} and installs root-only 0600 files."""
    cfg = load_cfg(tier, customer)
    d = json.load(sys.stdin)
    os.makedirs(cfg["creds_dir"], mode=0o700, exist_ok=True)
    os.chmod(cfg["creds_dir"], 0o700)
    names = {"repo_password": "repo-password", "rest_user": "rest-user", "rest_password": "rest-password",
             "maint_user": "maint-user", "maint_password": "maint-password"}
    for k, fn in names.items():
        if k in d:
            if not isinstance(d[k], str) or not re.fullmatch(r"[A-Za-z0-9_.-]{3,128}", d[k]):
                raise Fail(f"{k}: invalid format")
            fd = os.open(os.path.join(cfg["creds_dir"], fn), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(d[k] + "\n")
    return {"provisioned": sorted(k for k in names if k in d)}


def op_init(tier: str, customer: str | None = None) -> dict:
    cfg = load_cfg(tier, customer)
    r = restic(cfg, ["init", "--json"], timeout=120)
    if r.returncode != 0:
        raise Fail("restic init failed: " + Scrub(cfg)(r.stderr))
    return {"repo_id": j(r.stdout).get("id")}


def op_recovery_key(tier: str, out: str, customer: str | None = None) -> dict:
    """Adds a SECOND restic key (random, 256 bit) and writes it to `out` (0600, must not exist). The ICS stores only a fingerprint; the owner
    takes the file offline (print / safe) and shreds it. Losing the vault key then no longer means losing the backups."""
    cfg = load_cfg(tier, customer)
    if os.path.exists(out):
        raise Fail("output file exists")
    pw = secrets.token_urlsafe(32)
    tmp = os.path.join(cfg["stage_dir"], ".newkey")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(pw)
    try:
        r = restic(cfg, ["key", "add", "--new-password-file", tmp, "--host", "ou-recovery"], timeout=120)
        if r.returncode != 0:
            raise Fail("restic key add failed: " + Scrub(cfg)(r.stderr))
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(f"Office Unbound offline recovery key\nrepository: {cfg['repo_url']}\ntier: {tier}\nrepository password: {pw}\n")
    finally:
        os.unlink(tmp)
    fp = hashlib.sha256(b"ou-backup-key-fp-v1\n" + pw.encode()).hexdigest()[:16]
    return {"recovery_fp": fp, "file": out}


# ---- spool mode (agent runbook) -------------------------------------------------------------------------------------------------------
def validate(action: str, p: dict) -> dict:
    def exact(keys, req=None):
        req = tuple(req if req is not None else keys)
        keys = (*keys, "customer")
        if set(p) - set(keys) or set(req) - set(p):
            raise Fail("bad parameters")
        if "customer" in p and not (isinstance(p["customer"], str) and PROFILE_RE.match(p["customer"])):
            raise Fail("bad customer profile")
    if action == "backup.run":
        exact(("tier",))
    elif action == "backup.verify":
        exact(("tier", "level", "percent", "snapshot"), ("tier", "level"))
        if p["level"] not in ("check", "restore"):
            raise Fail("bad level")
        if "percent" in p and (type(p["percent"]) is not int or not 1 <= p["percent"] <= 100):
            raise Fail("bad percent")
        if "snapshot" in p and not (isinstance(p["snapshot"], str) and SNAP_RE.match(p["snapshot"])):
            raise Fail("bad snapshot")
    elif action == "backup.prune":
        exact(("tier", "last", "daily", "weekly", "monthly"))
        for k, hi in (("last", 100), ("daily", 366), ("weekly", 260), ("monthly", 240)):
            if type(p[k]) is not int or not 0 <= p[k] <= hi:
                raise Fail("bad retention")
        if sum(p[k] for k in ("last", "daily", "weekly", "monthly")) < 1:
            raise Fail("retention keeps nothing")
    else:
        raise Fail("unknown action")
    if p["tier"] not in TIERS:
        raise Fail("unknown tier")
    return p


def dispatch(action: str, p: dict) -> dict:
    p = validate(action, p)
    c = p.get("customer")
    if action == "backup.run":
        return op_run(p["tier"], c)
    if action == "backup.prune":
        return op_prune(p["tier"], p, c)
    if p["level"] == "check":
        return op_check(p["tier"], p.get("percent", 10), c)
    return op_restore(p["tier"], p.get("snapshot"), c)


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("must run as root", file=sys.stderr)
        return 2
    os.umask(0o077)
    if argv and argv[0] == "--direct":
        a = argv[1:]
        cust = None
        if a[:1] == ["--customer"]:
            cust, a = a[1], a[2:]
        cmd, tier, rest = a[0], a[1], a[2:]
        try:
            res = {"init": lambda: op_init(tier, cust), "provision": lambda: op_provision(tier, cust), "recovery-key": lambda: op_recovery_key(tier, rest[0], cust),
                   "run": lambda: op_run(tier, cust), "check": lambda: op_check(tier, int(rest[0]) if rest else 10, cust),
                   "restore": lambda: op_restore(tier, rest[0] if rest else None, cust),
                   "prune": lambda: op_prune(tier, dict(zip(("last", "daily", "weekly", "monthly"), map(int, rest))), cust)}[cmd]()
        except Fail as e:
            print(json.dumps({"error": str(e)}))
            return 1
        print(json.dumps(res, sort_keys=True))
        return 0
    rid = argv[0] if argv else ""
    if not RID_RE.match(rid):
        return 2
    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    out = {"rid": rid}
    try:
        spool = json.load(open(os.path.join(SPOOL_DIR, rid + ".json")))
        out["result"] = dispatch(spool["action"], spool["params"])
    except Fail as e:
        out["error"] = str(e)[:600]
    except Exception as e:  # noqa: BLE001
        out["error"] = f"internal error: {type(e).__name__}"
    for f in os.listdir(RUN_DIR):   # prune old results
        p = os.path.join(RUN_DIR, f)
        if os.path.getmtime(p) < now() - 86400:
            os.unlink(p)
    tmp = os.path.join(RUN_DIR, rid + ".tmp")
    with open(tmp, "w") as f:
        json.dump(out, f)
    os.chmod(tmp, 0o644)
    os.rename(tmp, os.path.join(RUN_DIR, rid + ".json"))
    return 0 if "error" not in out else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

[Unit]
Description=Office Unbound identity runbook (opencloud-revoke) for %i

[Service]
Type=oneshot
User=opencloud
Group=opencloud
EnvironmentFile=/etc/opencloud/opencloud.env
EnvironmentFile=/etc/opencloud/opencloud.secrets.env
ExecStart=/usr/local/sbin/ou-oc-revoke %i
RuntimeDirectory=ou-rb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Unit]
Description=Office Unbound identity runbook (gromox-kill) for %i

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/ou-gw-user kill %i
RuntimeDirectory=ou-rb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true

{
  "listen": {"address": "0.0.0.0", "port": 8443},
  "runbooks": {
    "service.restart": {"units": ["gromox-http", "gromox-imap", "gromox-delivery", "nginx", "php8.2-fpm", "postfix", "mariadb"]},
    "service.status":  {"units": ["gromox-http", "gromox-imap", "gromox-delivery", "nginx", "php8.2-fpm", "postfix", "mariadb"]},
    "disk.usage":      {"paths": ["/", "/var/lib/mysql", "/var/lib/gromox"]},
    "gromox.sync_user": {"enabled": true},
    "gromox.kick_user": {"enabled": true},
    "gromox.user_state": {"enabled": true},
    "gromox.kill_sessions": {"enabled": true},
    "gromox.wipe_devices": {"enabled": true},
    "gromox.devices": {"enabled": true},
    "gromox.set_aliases": {"enabled": true},
    "gromox.shared_create": {"enabled": true},
    "gromox.shared_delete": {"enabled": true},
    "gromox.shared_access": {"enabled": true},
    "gromox.shared_state": {"enabled": true},
    "gromox.set_quota": {"enabled": true},
    "gromox.mail_usage": {"enabled": true}
  }
}
